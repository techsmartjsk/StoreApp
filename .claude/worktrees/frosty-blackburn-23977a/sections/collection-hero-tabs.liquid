    font-weight: 700;
  }

  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========== Responsive ========== */
  @media screen and (max-width: 992px) {
