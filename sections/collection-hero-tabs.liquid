{%- assign has_mapped_content = false -%}
{%- capture handles -%}emerald,blue-sapphire,opal,ruby,yellow-sapphire,white-sapphire,red-coral,pearl,hessonite,cats-eye,amethyst,citrine,turquoise,navratana,upratnas,surya,chandra,mangal,budh,shukra,guru,shani,rahu,ketu,iolite,red-garnet,peridot,tourmaline,white-coral,agate,chalcedony,pitambari,aquamarine,natural-zircon,moonstone,lapis-lazuli,malachite,sphatik,blue-topaz,tiger-eye,purple-sapphire,padparadscha,star-sapphire{%- endcapture -%}
{%- assign handle_list = handles | split: ',' -%}
{%- for handle in handle_list -%}
  {%- if gem_handle == handle -%}
    {%- assign has_mapped_content = true -%}
    {%- break -%}
  {%- endif -%}
