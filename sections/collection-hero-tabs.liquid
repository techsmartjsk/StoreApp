{%- comment -%}
  Dynamic Collection Hero & Tabbed Content Section
  Pulls data from collection metafields for a premium, custom experience.
  Also supports hardcoded content for specific collection handles.
{%- endcomment -%}

{%- assign _planet_handles = 'surya,chandra,mangal,budh,shukra,guru,shani,rahu,ketu' | split: ',' -%}
{%- assign _is_planet_page = false -%}
{%- for _ph in _planet_handles -%}
  {%- if collection.handle == _ph -%}
    {%- assign _is_planet_page = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign summary = collection.description -%}
{%- assign benefits = 'Premium Certified Gemstones\nEnergized & Lab-Tested\n10-Day Easy Returns' -%}

{%- comment -%} ========== Hardcoded content for specific collections ========== {%- endcomment -%}
{%- assign gem_handle = collection.handle -%}

{%- comment -%}
  Sacred Essentials per-gem subcollections reuse the matching base gem's content
  (hero, About, Who Should Wear, Benefits, Pricing, Care, FAQ, Buyer Awareness).
  Only the collection/URL and its products differ — the editorial content is identical.
{%- endcomment -%}
{%- case collection.handle -%}
  {%- when 'sacred-essentials-manik-1' -%}         {%- assign gem_handle = 'ruby' -%}
  {%- when 'sacred-essentials-moti-1' -%}          {%- assign gem_handle = 'pearl' -%}
  {%- when 'sacred-essentials-panna-1' -%}         {%- assign gem_handle = 'emerald' -%}
  {%- when 'sacred-essentials-pukhraj-1' -%}       {%- assign gem_handle = 'yellow-sapphire' -%}
  {%- when 'sacred-essentials-safed-pukhraj-1' -%} {%- assign gem_handle = 'white-sapphire' -%}
  {%- when 'sacred-essentials-dudhiya-pathar' -%}  {%- assign gem_handle = 'opal' -%}
  {%- when 'sacred-essentials-neelam-1' -%}        {%- assign gem_handle = 'blue-sapphire' -%}
  {%- when 'sacred-essentials-gomed-1' -%}         {%- assign gem_handle = 'hessonite' -%}
  {%- when 'sacred-essentials-lehsunia-1' -%}      {%- assign gem_handle = 'cats-eye' -%}
  {%- when 'sacred-essentials-moonga-1' -%}        {%- assign gem_handle = 'red-coral' -%}
  {%- comment -%} Collection handle spelling differs from the content key (padparadscha) {%- endcomment -%}
  {%- when 'padparadsha-sapphire', 'padparadscha-sapphire', 'padparadsha', 'padparadscha-sapphire-1' -%} {%- assign gem_handle = 'padparadscha' -%}
{%- endcase -%}

