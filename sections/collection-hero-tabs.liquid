  /* ========== Emerald Custom Bilingual Style ========== */
  .gem-about--emerald {
    position: relative;
  }
  .gem-about__lang-toggle {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(59, 74, 47, 0.15);
    padding-bottom: 12px;
  }
  .gem-about__lang-btn {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 6px 16px;
    background: transparent;
    border: 1px solid #ccc;
    color: #555;
    cursor: pointer;
    transition: all 0.25s ease;
    border-radius: 4px;
  }
  .gem-about__lang-btn:hover {
    background: #fdfaf5;
    border-color: #3b4a2f;
