    to { opacity: 1; transform: translateY(0); }
  }

  /* Poetic & Rich Typography Layout */
  .gem-about__poetic-wrap {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .gem-about__quote-section {
    text-align: center;
    padding: 30px 20px;
