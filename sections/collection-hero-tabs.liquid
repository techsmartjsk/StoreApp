    margin-bottom: 12px;
    line-height: 1;
  }
  .gem-about__poetic-title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 24px;
    font-weight: 500;
    color: #3b4a2f;
    margin: 0 0 16px;
    letter-spacing: 0.02em;
    font-style: italic;
  }
  .gem-about__poetic-quote {
    margin: 0 auto;
    max-width: 600px;
    padding: 0;
    border: none;
  }
  .poetic-line {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 20px;
    line-height: 1.5;
    margin: 4px 0;
    color: #1a1a1a;
    font-weight: 500;
  }
  .gem-about__poetic-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.8;
    color: #333;
  }
  .gem-about__poetic-body p {
    margin: 0;
  }
  
  /* Astrological Grid */
  .gem-about__meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 16px 0;
  }
  .gem-about__meta-item {
    background: #fdfaf5;
    border: 1px solid rgba(59, 74, 47, 0.1);
    padding: 16px;
    text-align: center;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .meta-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8c8273;
  }
  .meta-value {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 18px;
    font-weight: 600;
    color: #3b4a2f;
  }

  /* Action Buttons / Links */
  .gem-about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 12px;
  }
  .gem-about__action-link {
    flex: 1 1 280px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: #fff;
    border: 1px solid #3b4a2f;
    color: #3b4a2f;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 2px 8px rgba(59, 74, 47, 0.05);
  }
  .gem-about__action-link:hover {
    background: #3b4a2f;
    color: #fff;
    box-shadow: 0 4px 15px rgba(59, 74, 47, 0.2);
    transform: translateY(-2px);
  }
  .gem-about__action-link .arrow {
    font-size: 16px;
    transition: transform 0.3s ease;
  }
  .gem-about__action-link:hover .arrow {
    transform: translateX(4px);
  }

  @media screen and (max-width: 640px) {
    .gem-about__meta-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .gem-about__poetic-title {
      font-size: 20px;
    }
    .poetic-line {
      font-size: 17px;
    }
    .gem-about__action-link {
      padding: 14px 20px;
    }
  }

  /* ========== FAQ Items ========== */
  .faq-item {
    margin-bottom: 24px;
  }
  .faq-item:last-child {
    margin-bottom: 0;
  }
  .faq-q {
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 4px;
    line-height: 1.5;
  }
  .faq-a {
    font-weight: 400;
    color: #444;
    margin: 0;
    line-height: 1.6;
  }
  /* Space between FAQ heading and first item */
  #tab-faq h2,
  #tab-faq h3 {
    margin-bottom: 28px;
  }
  /* Remove bullets from any raw <ul> in FAQ panels */
  #tab-faq ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>

<script>
  (function () {
    function initTabs() {
      const container = document.querySelector('.collection-hero-tabs');
      if (!container) return;

      const buttons = container.querySelectorAll('.collection-tabs__btn');
      const panels = container.querySelectorAll('.collection-tabs__panel');

      buttons.forEach((btn) => {
        btn.addEventListener('click', function () {
          const tabId = this.getAttribute('data-tab');
          const isActive = this.classList.contains('is-active');

          // Reset all others
          buttons.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          panels.forEach((p) => p.classList.remove('is-active'));

          // If it wasn't active, activate it. If it was already active, it stays removed (toggled off).
          if (!isActive) {
            this.classList.add('is-active');
            this.setAttribute('aria-selected', 'true');
            const targetPanel = container.querySelector(`#tab-${tabId}`);
            if (targetPanel) {
              targetPanel.classList.add('is-active');
            }
          }
        });
      });

      // Initialize language toggling inside panels (e.g. Emerald About tab)
      const langButtons = container.querySelectorAll('.gem-about__lang-btn');
      langButtons.forEach((langBtn) => {
        langBtn.addEventListener('click', function () {
          const lang = this.getAttribute('data-lang');
          const gemAbout = this.closest('.gem-about');
          if (!gemAbout) return;

          // Toggle buttons
          gemAbout.querySelectorAll('.gem-about__lang-btn').forEach((btn) => {
            btn.classList.toggle('is-active', btn === this);
          });

          // Toggle content blocks
          gemAbout.querySelectorAll('.gem-about__content').forEach((content) => {
            const contentLang = content.getAttribute('data-lang-content');
            content.classList.toggle('is-active', contentLang === lang);
          });
        });
      });
    }

    function applyPoeticFormat() {
      var hero = document.querySelector('.collection-hero__info-inner');
      if (!hero) return;

      function poeticize(text, isHindi) {
        if (isHindi) {
          return text.replace(/, /g, ',\n ');
        }
        return text
          .replace(/— /g, '—\n ')
          .replace(/\. ([A-Zऀ-ॿ])/g, '.\n$1')
          .replace(/, /g, ',\n ');
      }

      function processNode(node, isHindi) {
        if (node.nodeType === 3) {
          var orig = node.textContent;
          var transformed = poeticize(orig, isHindi);
          if (transformed !== orig) node.textContent = transformed;
        } else {
          node.childNodes.forEach(function (child) {
            processNode(child, isHindi);
          });
        }
      }

      var tagline = hero.querySelector('.collection-hero__tagline');
      if (tagline) processNode(tagline, false);

      hero.querySelectorAll('.collection-hero__description').forEach(function (el) {
        var isHindi = el.classList.contains('collection-hero__description--hindi');
        processNode(el, isHindi);
      });
    }

    function initFaqFormat() {
      const faqPanel = document.querySelector('#tab-faq');
      if (!faqPanel) return;

      // Collect all direct <p> and <li> nodes that look like FAQ items (contain '?')
      const candidates = faqPanel.querySelectorAll('li, p');

      candidates.forEach(function (el) {
        // Skip headings wrapped in <p> with no '?' or that are just labels
        const raw = el.textContent.trim();
        const qIdx = raw.indexOf('?');
        if (qIdx === -1) return;

        // Skip the PreciousCarats Promise / A Final Note paragraphs
        if (raw.startsWith('The PreciousCarats') || raw.startsWith('A Final Note')) return;

        const questionText = raw.substring(0, qIdx + 1).trim();
        const answerText = raw.substring(qIdx + 1).trim();
        if (!answerText) return; // question with no answer — leave as-is

        const wrapper = document.createElement('div');
        wrapper.className = 'faq-item';
        wrapper.innerHTML =
          '<p class="faq-q">' + questionText + '</p>' +
          '<p class="faq-a">' + answerText + '</p>';

        // Replace <li> with wrapper div, or <p> with wrapper div
        el.parentNode.insertBefore(wrapper, el);
        el.parentNode.removeChild(el);
      });

      // Remove now-empty <ul> shells
      faqPanel.querySelectorAll('ul').forEach(function (ul) {
        if (ul.children.length === 0) ul.parentNode.removeChild(ul);
      });
    }

    // Normalize the hand-authored gem-tab copy so every gem renders consistently:
    //  • paragraphs starting with "* " become real bullet lists
    //  • leading "**" markdown markers and stray "→" arrows are removed
    //  • short "Label:" subtitles (Do:, Avoid:, On treatments:, Note: …) are bolded
    //  • Title-Case benefit headings before an em dash (Clarity & Judgment — …) are bolded
    function normalizeChtContent() {
      var panels = document.querySelectorAll('.collection-tabs__panel-content');
      if (!panels.length) return;

      // A benefit-style heading is Title Case: every significant word starts uppercase.
      function looksLikeTitle(s) {
        var words = s.trim().split(/\s+/);
        var skip = { of: 1, the: 1, and: 1, to: 1, a: 1, an: 1, in: 1, for: 1, '&': 1 };
        var significant = 0, capped = 0;
        for (var i = 0; i < words.length; i++) {
          var w = words[i].replace(/[^A-Za-z&'-]/g, '');
          if (!w || skip[w.toLowerCase()]) continue;
          significant++;
          if (/^[A-Z]/.test(w)) capped++;
        }
        return significant >= 1 && capped === significant;
      }

      panels.forEach(function (panel) {
        // The FAQ panel has its own formatter, and the About panel is bespoke
        // poetic prose — leave both untouched.
        if (panel.closest('#tab-faq') || panel.closest('#tab-about')) return;

        // --- Rule A: consecutive "* …" paragraphs become a single bullet list ---
        var paras = Array.prototype.slice.call(panel.querySelectorAll('p'));
        for (var i = 0; i < paras.length; i++) {
          if (!/^\s*\*\s+/.test(paras[i].textContent)) continue;
          var ul = document.createElement('ul');
          var j = i, last = paras[i];
          while (j < paras.length) {
            if (j > i && paras[j].previousElementSibling !== last) break; // not adjacent
            if (!/^\s*\*\s+/.test(paras[j].textContent)) break;
            var li = document.createElement('li');
            li.innerHTML = paras[j].innerHTML.replace(/^\s*\*\s+/, '');
            ul.appendChild(li);
            last = paras[j];
            j++;
          }
          paras[i].parentNode.insertBefore(ul, paras[i]);
          for (var k = i; k < j; k++) paras[k].parentNode.removeChild(paras[k]);
          i = j - 1;
        }

        // --- Rules B/C/D: clean markers and bold the leading label/title ---
        panel.querySelectorAll('p, li').forEach(function (el) {
          if (el.firstElementChild && el.firstElementChild.tagName === 'STRONG') return;

          var first = el.firstChild;
          if (!first || first.nodeType !== 3) return; // only text-leading items

          // Rule B: drop a leading "**" marker and any "→" arrows.
          var cleaned = first.nodeValue
            .replace(/^\s*\*\*\s*/, '')
            .replace(/→/g, ' ')
            .replace(/\s{2,}/g, ' ')
            .replace(/^\s+/, '');
          if (cleaned !== first.nodeValue) first.nodeValue = cleaned;

          var lead = first.nodeValue;
          var matchStr = null;

          // Rule C: a short "Label:" subtitle (≤ 6 words).
          var c = lead.match(/^([A-Z][^:<>]{0,38}?:)(\s|$)/);
          if (c && c[1].replace(/:$/, '').trim().split(/\s+/).length <= 6) {
            matchStr = c[1];
          } else {
            // Rule D: a Title-Case heading before an em dash.
            var d = lead.match(/^(\S.{0,40}?)\s—\s/);
            if (d && looksLikeTitle(d[1])) matchStr = d[1];
          }
          if (!matchStr) return;

          // Wrap just the matched portion in <strong>, preserving the rest.
          var rest = document.createTextNode(first.nodeValue.slice(matchStr.length));
          var strong = document.createElement('strong');
          strong.textContent = matchStr;
          el.replaceChild(rest, first);
          el.insertBefore(strong, rest);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initTabs();
        applyPoeticFormat();
        normalizeChtContent();
        initFaqFormat();
      });
    } else {
      initTabs();
      applyPoeticFormat();
      normalizeChtContent();
      initFaqFormat();
    }
  })();
</script>

