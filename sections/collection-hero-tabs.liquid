{%- comment -%}
  Dynamic Collection Hero & Tabbed Content Section
  Pulls data from collection metafields for a premium, custom experience.
  Also supports hardcoded content for specific collection handles.
{%- endcomment -%}

{%- assign _planet_handles = 'surya,chandra,mangal,budh,shukra,guru,shani,rahu,ketu' | split: ',' -%}
{%- assign _is_planet_page = false -%}
{%- for _ph in _planet_handles -%}
  {%- if collection.handle == _ph -%}
    {%- assign _is_planet_page = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign summary = collection.description -%}
{%- assign benefits = 'Premium Certified Gemstones\nEnergized & Lab-Tested\n7-Day Easy Returns' -%}

{%- comment -%} ========== Hardcoded content for specific collections ========== {%- endcomment -%}
{%- assign gem_handle = collection.handle -%}

{%- comment -%} Hero overrides {%- endcomment -%}
{%- if gem_handle == 'blue-sapphire' -%}
  {%- assign hero_tagline = 'Where stillness becomes strength. Where depth holds its ground.' -%}
  {%- assign benefits = 'Certified Natural Blue Sapphire\nTreatment Fully Disclosed\nNo Glass or Diffusion Filling' -%}
{%- elsif gem_handle == 'emerald' -%}
  {%- assign hero_tagline = 'Where clarity does not arrive loudly — it settles.' -%}
  {%- assign benefits = 'Certified Natural Emerald\n100% Treatment Disclosure\nNo Resin, Polymer, or Glass Filling' -%}
{%- elsif gem_handle == 'opal' -%}
  {%- assign hero_tagline = 'Where colour does not stay — it breathes.' -%}
  {%- assign benefits = 'Certified Natural Opal\nUntreated & Uncoated\nNo Doublets, Triplets, Wax, or Resin' -%}
{%- elsif gem_handle == 'ruby' -%}
  {%- assign hero_tagline = 'Where fire becomes purpose. Where presence finds its centre.' -%}
  {%- assign benefits = 'Certified Natural Ruby\n100% Treatment Disclosure\nNo Glass or Lead Filling' -%}
{%- elsif gem_handle == 'yellow-sapphire' -%}
  {%- assign hero_tagline = 'Where light does not overwhelm — it guides.' -%}
  {%- assign benefits = 'Certified Natural Yellow Sapphire\n100% Treatment Disclosure\nNo Glass or Diffusion Filling' -%}
{%- elsif gem_handle == 'white-sapphire' -%}
  {%- assign hero_tagline = 'Where light does not dazzle — it settles.' -%}
  {%- assign benefits = 'Certified Natural White Sapphire\n100% Treatment Disclosure\nNo Glass Filling or Coating' -%}
{%- elsif gem_handle == 'red-coral' -%}
  {%- assign hero_tagline = 'Where fire does not provoke — it steadies.' -%}
  {%- assign benefits = 'Certified Natural Red Coral\nOcean-Origin Verified\nNo Chemical Treatment or Dye' -%}
{%- elsif gem_handle == 'pearl' -%}
  {%- assign hero_tagline = 'Where calm is not created — it returns.' -%}
  {%- assign benefits = 'Certified Natural Pearl\nOrigin Fully Disclosed\nNo Bleaching or Artificial Coating' -%}
{%- elsif gem_handle == 'hessonite' -%}
  {%- assign hero_tagline = 'Where fire does not confuse — it clarifies.' -%}
  {%- assign benefits = 'Certified Natural Hessonite\n100% Treatment Disclosure\nNo Glass Filling or Artificial Enhancement' -%}
{%- elsif gem_handle == 'cats-eye' -%}
  {%- assign hero_tagline = 'Where focus becomes visible.' -%}
  {%- assign benefits = 'Certified Natural Chrysoberyl\nSharp Visible Chatoyancy\nNo Glass Filling or Artificial Enhancement' -%}
{%- elsif gem_handle == 'amethyst' -%}
  {%- assign hero_tagline = 'Where stillness becomes clarity.' -%}
  {%- assign benefits = 'Certified Natural Amethyst\n100% Treatment Disclosure\nNo Glass Filling or Artificial Colouring' -%}
{%- elsif gem_handle == 'citrine' -%}
  {%- assign hero_tagline = 'Where light does not push — it guides.' -%}
  {%- assign benefits = 'Certified Natural Citrine\n100% Treatment Disclosure\nNo Glass Filling or Artificial Colouring' -%}
{%- elsif gem_handle == 'turquoise' -%}
  {%- assign hero_tagline = 'Where sky meets earth.' -%}
  {%- assign benefits = 'Certified Natural Turquoise\n100% Treatment Disclosure\nNo Resin Filling or Reconstitution' -%}
{%- endif -%}


{%- comment -%} Check if we have mapped content for this collection {%- endcomment -%}
{%- assign has_mapped_content = false -%}
{%- capture handles -%}emerald,blue-sapphire,opal,ruby,yellow-sapphire,white-sapphire,red-coral,pearl,hessonite,cats-eye,amethyst,citrine,turquoise,surya,chandra,mangal,budh,shukra,guru,shani,rahu,ketu,iolite,red-garnet,peridot,tourmaline,white-coral,agate,chalcedony,pitambari,aquamarine,natural-zircon,moonstone,lapis-lazuli,malachite,sphatik,blue-topaz,tiger-eye,purple-sapphire,padparadscha,star-sapphire{%- endcapture -%}
{%- assign handle_list = handles | split: ',' -%}
{%- for handle in handle_list -%}
  {%- if gem_handle == handle -%}
    {%- assign has_mapped_content = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<!-- Breadcrumb — above hero -->
<div class="cht-breadcrumb">
  <div class="page-width">
    <nav class="cht-breadcrumb__nav" aria-label="Breadcrumb">
      <a href="/" class="cht-breadcrumb__link">Home</a>
      <span class="cht-breadcrumb__sep">|</span>
      {%- if collection.handle == 'ruby'
        or collection.handle == 'emerald'
        or collection.handle == 'blue-sapphire'
        or collection.handle == 'yellow-sapphire'
        or collection.handle == 'white-sapphire'
        or collection.handle == 'pearl'
        or collection.handle == 'red-coral'
        or collection.handle == 'hessonite'
        or collection.handle == 'cateye'
      -%}
        <a href="/collections/navratana" class="cht-breadcrumb__link">Navratna</a>
        <span class="cht-breadcrumb__sep">|</span>
      {%- elsif collection.handle == 'opal'
        or collection.handle == 'amethyst'
        or collection.handle == 'citrine'
        or collection.handle == 'iolite'
        or collection.handle == 'red-garnet'
        or collection.handle == 'turquoise'
        or collection.handle == 'peridot'
        or collection.handle == 'tourmaline'
        or collection.handle == 'white-coral'
        or collection.handle == 'agate'
        or collection.handle == 'chalcedony'
        or collection.handle == 'pitambari'
        or collection.handle == 'aquamarine'
        or collection.handle == 'natural-zircon'
        or collection.handle == 'moonstone'
        or collection.handle == 'lapis-lazuli'
        or collection.handle == 'malachite'
        or collection.handle == 'sphatik'
        or collection.handle == 'blue-topaz'
        or collection.handle == 'tiger-eye'
      -%}
        <a href="/collections/upratnas" class="cht-breadcrumb__link">Upratnas</a>
        <span class="cht-breadcrumb__sep">|</span>
      {%- endif -%}
      <span class="cht-breadcrumb__current">{{ collection.title }}</span>
    </nav>
  </div>
</div>

<div class="collection-hero-tabs" id="CollectionHeroTabs-{{ section.id }}">
  <!-- 1. Split Hero Section -->
  <div class="collection-hero">
    <div class="collection-hero__lifestyle">
      {%- if collection.image -%}
        <img src="{{ collection.image | image_url: width: 1200 }}" alt="{{ collection.title }}" loading="lazy">
      {%- elsif collection.handle == 'opal' -%}
        <img src="{{ 'opal.png' | asset_url }}" alt="{{ collection.title }}" loading="lazy">
      {%- else -%}
        <img src="{{ 'collection-default-page.png' | asset_url }}" alt="Gemstone collection placeholder" loading="lazy">
      {%- endif -%}
    </div>

    <div class="collection-hero__info">
      <div class="collection-hero__info-inner">
        {%- assign _icon_asset = 'nav-' | append: collection.handle | append: '.png' -%}

        <h1 class="collection-hero__title">{{ collection.title }}</h1>

        {%- if collection.description != blank -%}
          <div class="collection-hero__description rte">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- 2. Tabbed Content Section -->
  <div class="collection-tabs-wrapper">
      <div class="page-width">
        {%- if has_mapped_content -%}
        <nav class="collection-tabs" aria-label="Collection tabs">
          <ul class="collection-tabs__list" role="tablist">
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="about">ABOUT</button>
            </li>
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="who-wear">WHO SHOULD WEAR</button>
            </li>
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="benefits">BENEFITS</button>
            </li>
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="pricing">PRICING &amp; ORIGINS</button>
            </li>
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="care-guide">CARE GUIDE</button>
            </li>
            <li class="collection-tabs__item">
              <button class="collection-tabs__btn" role="tab" aria-selected="false" data-tab="faq">FAQ</button>
            </li>
          </ul>
        </nav>

        <div class="collection-tabs__panels">
          <!-- Panel 1: ABOUT -->
          <div class="collection-tabs__panel" id="tab-about" role="tabpanel">
            <h2 class="collection-tabs__panel-title">About {{ collection.title }}</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-about’, gem_handle: gem_handle -%}
            </div>
          </div>

          <!-- Panel 2: WHO SHOULD WEAR -->
          <div class="collection-tabs__panel" id="tab-who-wear" role="tabpanel">
            <h2 class="collection-tabs__panel-title">Who Should Wear</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-who-wear’, gem_handle: gem_handle -%}
            </div>
          </div>

          <!-- Panel 3: BENEFITS -->
          <div class="collection-tabs__panel" id="tab-benefits" role="tabpanel">
            <h2 class="collection-tabs__panel-title">The Power & Benefits of {{ collection.title }}</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-benefits’, gem_handle: gem_handle -%}
            </div>
          </div>

          <!-- Panel 4: PRICING -->
          <div class="collection-tabs__panel" id="tab-pricing" role="tabpanel">
            <h2 class="collection-tabs__panel-title">The Value & Pricing of {{ collection.title }}</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-pricing’, gem_handle: gem_handle -%}
            </div>
          </div>

          <!-- Panel 5: CARE GUIDE -->
          <div class="collection-tabs__panel" id="tab-care-guide" role="tabpanel">
            <h2 class="collection-tabs__panel-title">Preserving Your Gemstone’s Energy</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-care’, gem_handle: gem_handle -%}
            </div>
          </div>

          <!-- Panel 6: FAQ -->
          <div class="collection-tabs__panel" id="tab-faq" role="tabpanel">
            <h2 class="collection-tabs__panel-title">Frequently Asked Questions</h2>
            <div class="collection-tabs__panel-content rte">
              {%- render ‘cht-faq’, gem_handle: gem_handle -%}
            </div>
          </div>
        </div>
        {%- endif -%}

      </div>
    </div>
</div>

<style>
  /* ========== Breadcrumb ========== */
  .cht-breadcrumb {
    padding: 12px 0;
    background: #fafafa;
    border-bottom: 1px solid #eee;
  }
  .cht-breadcrumb__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    color: #888;
    padding-left: 4px;
  }
  .cht-breadcrumb__link {
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
  }
  .cht-breadcrumb__link:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }
  .cht-breadcrumb__sep {
    color: #bbb;
    font-size: 12px;
  }
  .cht-breadcrumb__current {
    color: #1a1a1a;
    font-weight: 600;
  }

  /* ========== Hero Tabs Container ========== */
  .collection-hero-tabs {
    background: transparent;
    margin-bottom: 0;
  }

  /* ========== Split Hero ========== */
  .collection-hero {
    display: flex;
    flex-wrap: nowrap;
    background: #fff;
    min-height: 400px;
  }

  .collection-hero--no-tabs {
    margin-bottom: 40px;
  }

  .collection-hero__lifestyle {
    flex: 0 0 55%;
    max-width: 55%;
    min-height: 400px;
    position: relative;
    overflow: hidden;
  }
  .collection-hero__lifestyle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .collection-hero__placeholder {
    width: 100%;
    height: 100%;
    background: #e5e5e5;
  }

  .collection-hero__info {
    flex: 0 0 45%;
    max-width: 45%;
    background: #f5f0eb;
    display: flex;
    align-items: center;
    padding: 44px 48px;
  }

  .collection-hero__info-inner {
    max-width: 520px;
    margin: 0;
  }

  .collection-hero__icon {
    width: 90px;
    height: 90px;
    margin-bottom: 20px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }
  .collection-hero__icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .collection-hero__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 36px;
    font-weight: 500;
    margin: 0 0 14px;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .collection-hero__tagline {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 17px;
    font-style: italic;
    color: #6b5c3e;
    margin: -8px 0 18px;
    line-height: 1.4;
  }

  .collection-hero__description {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: #444;
    margin-bottom: 22px;
  }

  .collection-hero__benefits {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .collection-hero__benefits li {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    margin-bottom: 6px;
    color: #333;
    font-weight: 500;
    line-height: 1.5;
  }

  /* ========== Tabs Bar ========== */
  .collection-tabs-wrapper {
    background: transparent;
    padding: 0;
  }

  .collection-tabs {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: transparent;
    border: none;
    padding: 24px 0 0;
  }
  .collection-tabs::-webkit-scrollbar {
    display: none;
  }

  .collection-tabs__list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 20px;
    max-width: 1200px;
    margin: 0 auto;
    gap: 12px;
  }

  .collection-tabs__item {
    flex: 1;
    border: none;
  }

  .collection-tabs__btn {
    width: 100%;
    padding: 18px 12px;
    background: transparent;
    border: 1px solid #ccc;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #2c3e50;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    text-transform: uppercase;
    border-radius: 0;
  }

  .collection-tabs__btn:hover {
    background: #f5f5f5;
  }

  .collection-tabs__btn.is-active {
    color: #fff;
    background: #3b4a2f;
    border-color: #3b4a2f;
  }

  /* ========== Tab Panels ========== */
  .collection-tabs__panels {
    padding: 40px 0 60px;
    background: transparent;
  }

  .collection-tabs__panel {
    display: none;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
    animation: fadeInTab 0.4s ease;
  }

  .collection-tabs__panel.is-active {
    display: block;
  }

  .collection-tabs__panel-title {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 20px;
    color: #1a1a1a;
    border: none;
    padding: 0;
  }

  .collection-tabs__panel-content {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.8;
    color: #444;
  }

  .collection-tabs__panel-content ul {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }
  .collection-tabs__panel-content ul li {
    padding: 3px 0;
    font-size: 15px;
    color: #333;
    line-height: 1.7;
  }
  .collection-tabs__panel-content ul li::before {
    content: '•  ';
    color: #333;
    font-weight: 700;
  }

  @keyframes fadeInTab {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ========== Responsive ========== */
  @media screen and (max-width: 992px) {
    .collection-hero__lifestyle {
      min-height: 360px;
    }
    .collection-hero__info {
      padding: 36px 28px;
    }
    .collection-hero__title {
      font-size: 30px;
    }
  }

  @media screen and (max-width: 768px) {
    .collection-hero {
      flex-wrap: wrap;
    }
    .collection-hero__lifestyle {
      flex: 1 1 100%;
      max-width: 100%;
      min-height: 280px;
    }
    .collection-hero__info {
      flex: 1 1 100%;
      max-width: 100%;
      padding: 30px 20px;
    }
    .collection-hero__title {
      font-size: 28px;
    }
    .collection-tabs__list {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
    .collection-tabs__item {
      flex: 0 0 auto;
    }
    .collection-tabs__btn {
      padding: 14px 16px;
      font-size: 11px;
    }
    .collection-tabs__panels {
      padding: 30px 0 40px;
    }
    .cht-breadcrumb__nav {
      font-size: 12px;
    }
  }
</style>

<script>
  (function () {
    function initTabs() {
      const container = document.querySelector('.collection-hero-tabs');
      if (!container) return;

      const buttons = container.querySelectorAll('.collection-tabs__btn');
      const panels = container.querySelectorAll('.collection-tabs__panel');

      buttons.forEach((btn) => {
        btn.addEventListener('click', function () {
          const tabId = this.getAttribute('data-tab');
          const isActive = this.classList.contains('is-active');

          // Reset all others
          buttons.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          panels.forEach((p) => p.classList.remove('is-active'));

          // If it wasn't active, activate it. If it was already active, it stays removed (toggled off).
          if (!isActive) {
            this.classList.add('is-active');
            this.setAttribute('aria-selected', 'true');
            const targetPanel = container.querySelector(`#tab-${tabId}`);
            if (targetPanel) {
              targetPanel.classList.add('is-active');
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTabs);
    } else {
      initTabs();
    }
  })();
</script>

{% schema %}
{
  "name": "Collection Hero & Tabs",
  "settings": [],
  "presets": [
    {
      "name": "Collection Hero & Tabs"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
