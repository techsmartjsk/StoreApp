<style>
  /* ========== Breadcrumb ========== */
  .cht-breadcrumb {
    padding: 12px 0;
    background: #fafafa;
    border-bottom: 1px solid #eee;
  }
  .cht-breadcrumb__nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    color: #888;
    padding-left: 4px;
  }
  .cht-breadcrumb__link {
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
  }
  .cht-breadcrumb__link:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }
  .cht-breadcrumb__sep {
    color: #bbb;
    font-size: 12px;
  }
  .cht-breadcrumb__current {
    color: #1a1a1a;
    font-weight: 600;
  }

  /* ========== Hero Tabs Container ========== */
  .collection-hero-tabs {
    background: transparent;
    margin-bottom: 0;
  }

  /* ========== Split Hero ========== */
  .collection-hero {
    display: flex;
    flex-wrap: nowrap;
    background: #fff;
    min-height: 400px;
  }

  .collection-hero--no-tabs {
    margin-bottom: 40px;
  }

  .collection-hero__lifestyle {
    flex: 0 0 55%;
    max-width: 55%;
    min-height: 400px;
    position: relative;
    overflow: hidden;
  }
  .collection-hero__lifestyle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .collection-hero__placeholder {
    width: 100%;
    height: 100%;
    background: #e5e5e5;
  }

  .collection-hero__info {
    flex: 0 0 45%;
    max-width: 45%;
    background: #f5f0eb;
    display: flex;
    align-items: center;
    padding: 44px 48px;
  }

  .collection-hero__info-inner {
    max-width: 520px;
    margin: 0;
  }

  .collection-hero__icon {
    width: 90px;
    height: 90px;
    margin-bottom: 20px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px;
  }
  .collection-hero__icon img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .collection-hero__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 36px;
    font-weight: 500;
    margin: 0 0 14px;
    color: #1a1a1a;
    line-height: 1.2;
  }

  .collection-hero__welcome {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .collection-hero__tagline {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 17px;
    font-style: italic;
    color: #6b5c3e;
    margin: 0 0 20px;
    line-height: 1.7;
    white-space: pre-line;
  }

  .collection-hero__description {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.9;
    color: #444;
    margin: 0 0 16px;
    white-space: pre-line;
  }

  .collection-hero__description--hindi {
    margin: 0 0 20px;
  }

  .collection-hero__benefits {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
  }
  .collection-hero__benefits li {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    margin-bottom: 10px;
    color: #333;
    font-weight: 500;
    line-height: 1.5;
  }
  .collection-hero__benefits li:last-child {
    margin-bottom: 0;
  }

  /* ========== Tabs Bar ========== */
  .collection-tabs-wrapper {
    background: transparent;
    padding: 0;
  }

  .collection-tabs {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: transparent;
    border: none;
    padding: 24px 0 0;
  }
  .collection-tabs::-webkit-scrollbar {
    display: none;
  }

  .collection-tabs__list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 20px;
    max-width: 1200px;
    margin: 0 auto;
    gap: 12px;
  }

  .collection-tabs__item {
    flex: 1;
    border: none;
  }

  .collection-tabs__btn {
    width: 100%;
    padding: 18px 12px;
    background: transparent;
    border: 1px solid #ccc;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #2c3e50;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
    text-transform: uppercase;
    border-radius: 0;
  }

  .collection-tabs__btn:hover {
    background: #f5f5f5;
  }

  .collection-tabs__btn.is-active {
    color: #fff;
    background: #3b4a2f;
    border-color: #3b4a2f;
  }


  /* ========== Tab Panels ========== */
  .collection-tabs__panels {
    padding: 40px 0 60px;
    background: transparent;
  }

  .collection-tabs__panel {
    display: none;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
