{%- comment -%}
  Featured Products Section
  Product carousel with optional side promo banner
{%- endcomment -%}

{%- assign collection = collections[section.settings.collection] -%}
{%- assign products_to_show = 0 -%}

{%- comment -%}
  Render a larger pool of products when random order is on, so the client-side
  shuffle has something to pick 10 from. Display count is products_count.
{%- endcomment -%}
{%- assign pool_count = section.settings.products_count -%}
{%- if section.settings.random_order -%}
  {%- assign pool_count = section.settings.random_pool | default: 24 -%}
{%- endif -%}

{%- if section.settings.editorial_filter != blank -%}
  {%- for product in collection.products -%}
    {%- if product.metafields.custom.editorial == section.settings.editorial_filter -%}
      {%- assign products_to_show = products_to_show | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- elsif section.settings.collection != blank -%}
  {%- assign products_to_show = collection.all_products_count -%}
{%- else -%}
  {%- comment -%}Placeholder mode{%- endcomment -%}
  {%- assign products_to_show = section.settings.products_count -%}
{%- endif -%}

{%- if products_to_show > 0 -%}

<section class="featured-products section-{{ section.id }} reveal" id="featured-products-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
  <div class="featured-products__split">
    {%- if section.settings.show_promo -%}
      <div class="featured-products__promo">
        <div class="featured-products__promo-image">
          {%- if section.settings.asset_name != blank -%}
            <img src="{{ section.settings.asset_name | asset_url }}" alt="" loading="lazy">
          {%- elsif section.settings.promo_image -%}
            <img src="{{ section.settings.promo_image | image_url: width: 800 }}" alt="" loading="lazy">
          {%- else -%}
            <div class="promo-placeholder"></div>
          {%- endif -%}
        </div>
        <div class="featured-products__promo-content">
          <h3 class="promo-title">{{ section.settings.promo_title }}</h3>
          <p class="promo-subtitle">{{ section.settings.promo_subtitle }}</p>
        </div>
      </div>
    {%- endif -%}

    <div class="featured-products__main">
      <div class="featured-products__header">
        <div class="featured-products__headline">
          <h2 class="featured-products__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="featured-products__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_url != blank -%}
          <a href="{{ section.settings.view_all_url }}" class="view-all-link">
            {{ section.settings.view_all_text | default: 'VIEW ALL' }}
          </a>
        {%- endif -%}
      </div>

      <div class="featured-products__carousel-container">
        <div class="featured-products__grid scroll-container" id="featured-grid-{{ section.id }}">
          {%- if section.settings.editorial_filter != blank -%}
            {%- assign editorial_shown = 0 -%}
            {%- for product in collection.products -%}
              {%- if product.metafields.custom.editorial == section.settings.editorial_filter -%}
                <div class="carousel-item">
                  {% render 'product-card', product: product %}
                </div>
                {%- assign editorial_shown = editorial_shown | plus: 1 -%}
                {%- if editorial_shown >= pool_count -%}{%- break -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif section.settings.collection != blank and section.settings.random_order -%}
            {%- comment -%}
              Balance the pool across distinct gem types so the carousel isn't all
              one gem (the collection lists all of one type before the next).
              Take up to `per_type` products from each gem type, capped at pool_count.
            {%- endcomment -%}
            {%- assign per_type = section.settings.per_type_limit | default: 4 -%}
            {%- assign gt_seen = '' -%}
            {%- for product in collection.products -%}
              {%- assign _gt = product.metafields.custom.gem_type | default: 'other' | strip | handleize -%}
              {%- assign _tok = _gt | append: '||' -%}
              {%- unless gt_seen contains _tok -%}
                {%- assign gt_seen = gt_seen | append: _tok -%}
              {%- endunless -%}
            {%- endfor -%}
            {%- assign gt_types = gt_seen | split: '||' -%}
            {%- assign pool_rendered = 0 -%}
            {%- for t in gt_types -%}
              {%- if t == blank -%}{%- continue -%}{%- endif -%}
              {%- assign t_rendered = 0 -%}
              {%- for product in collection.products -%}
                {%- assign _pgt = product.metafields.custom.gem_type | default: 'other' | strip | handleize -%}
                {%- if _pgt == t -%}
                  <div class="carousel-item">
                    {% render 'product-card', product: product %}
                  </div>
                  {%- assign t_rendered = t_rendered | plus: 1 -%}
                  {%- assign pool_rendered = pool_rendered | plus: 1 -%}
                  {%- if t_rendered >= per_type -%}{%- break -%}{%- endif -%}
                  {%- if pool_rendered >= pool_count -%}{%- break -%}{%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if pool_rendered >= pool_count -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- elsif section.settings.collection != blank -%}
            {%- for product in collection.products limit: pool_count -%}
              <div class="carousel-item">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..section.settings.products_count) -%}
              <div class="carousel-item">
                {% render 'product-card', product: nil %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <button class="carousel-nav-btn next-btn" aria-label="Next products" onclick="const container = document.getElementById('featured-grid-{{ section.id }}'); container.scrollBy({left: container.offsetWidth * 0.8, behavior: 'smooth'})">
          {% render 'icon', name: 'play' %}
        </button>
      </div>

      <div class="featured-products__dots">
        <div class="dot active"></div>
        <div class="dot"></div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;
    const grid = section.querySelector('.featured-products__grid');
    if (!grid) return;

    const displayCount = {{ section.settings.products_count | default: 10 }};
    const randomOrder = {{ section.settings.random_order | default: true }};

    let items = Array.from(grid.querySelectorAll('.carousel-item'));
    if (!items.length) return;

    // Show a random subset of `displayCount` products (Fisher–Yates shuffle).
    if (randomOrder) {
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
    }
    items.forEach((item, idx) => {
      if (idx < displayCount) grid.appendChild(item); // re-append in new order
      else item.remove();                             // drop the rest of the pool
    });
    items = Array.from(grid.querySelectorAll('.carousel-item'));
    if (!items.length) return;

    // Clone the visible set once so the marquee can loop seamlessly.
    items.forEach((item) => {
      const clone = item.cloneNode(true);
      clone.classList.add('carousel-item--clone');
      clone.setAttribute('aria-hidden', 'true');
      // Strip ids/inputs from clones to avoid duplicate-id and duplicate-form issues.
      clone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
      grid.appendChild(clone);
    });

    // Respect users who prefer reduced motion — skip the auto-scroll entirely.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    // Continuous auto-scroll. Reset by one set width for a seamless loop.
    grid.style.scrollBehavior = 'auto';
    let setWidth = 0;
    const measure = () => { setWidth = grid.scrollWidth / 2; };
    measure();
    window.addEventListener('resize', measure);

    const speed = 0.6; // px per frame (~36px/s at 60fps)
    let paused = false;   // hover/interaction
    let onScreen = true;  // in viewport
    let rafId = null;

    const step = () => {
      if (!paused && onScreen && setWidth > 0) {
        grid.scrollLeft += speed;
        if (grid.scrollLeft >= setWidth) grid.scrollLeft -= setWidth;
      }
      rafId = requestAnimationFrame(step);
    };
    const start = () => { if (rafId === null) rafId = requestAnimationFrame(step); };
    const stop = () => { if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } };

    // Only animate while the carousel is actually in the viewport.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        onScreen = entries[0].isIntersecting;
        if (onScreen) start(); else stop();
      }, { threshold: 0 }).observe(section);
    }
    // Also stop when the tab is hidden.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else start();
    });

    start();

    // Pause while the user is hovering or interacting.
    grid.addEventListener('mouseenter', () => { paused = true; });
    grid.addEventListener('mouseleave', () => { paused = false; });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CRUSH-WORTHY DELIGHTS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore mother nature's rarest creations in colour",
      "info": "Optional line below the main heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "editorial_filter",
      "label": "Editorial Metafield Filter",
      "info": "Only show products whose editorial metafield matches this value (e.g. Crush worthy delights)"
    },
    {
      "type": "range",
      "id": "products_count",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 10,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "random_order",
      "label": "Randomize products",
      "default": true,
      "info": "Show a random subset on each load, and auto-scroll continuously."
    },
    {
      "type": "range",
      "id": "random_pool",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 24,
      "label": "Randomize from this many products",
      "info": "Max size of the pool the random subset is drawn from. Ignored when Randomize is off."
    },
    {
      "type": "range",
      "id": "per_type_limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Max per gem type",
      "info": "When randomizing, take at most this many products from each gem type so all types appear."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    },
    {
      "type": "header",
      "content": "Promo Banner"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo banner",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promo image"
    },
    {
      "type": "text",
      "id": "asset_name",
      "label": "Promo Asset Name (e.g. strand-1.jpg)"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Promo title",
      "default": "Elegance within reach"
    },
    {
      "type": "text",
      "id": "promo_subtitle",
      "label": "Promo subtitle",
      "default": "GEMSTONES UNDER ₹50,000"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
