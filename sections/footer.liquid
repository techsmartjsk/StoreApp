{%- comment -%}
  Footer Section
{%- endcomment -%}

<footer class="site-footer" id="site-footer">
  <div class="page-width">
    <div class="footer__grid">
      <!-- Brand Column -->
      <div class="footer__brand">
        <div class="footer__logo">
          {%- if section.settings.logo_asset != blank -%}
            <img
              src="{{ section.settings.logo_asset | asset_url }}"
              alt="{{ section.settings.brand_name | default: shop.name }}"
            >
          {%- else -%}
            <img src="{{ 'logo.png' | asset_url }}" alt="{{ section.settings.brand_name | default: shop.name }}">
          {%- endif -%}
        </div>
        <p class="footer__brand-text">{{ section.settings.brand_description }}</p>
      </div>

      <!-- Contact Column (Conditional) -->
      {%- if section.settings.contact_phone != blank
        or section.settings.contact_email != blank
        or section.settings.contact_whatsapp != blank
        or section.settings.social_instagram != blank
        or section.settings.social_facebook != blank
        or section.settings.contact_address != blank
      -%}
        <div class="footer__column">
          <nav class="footer__links" aria-label="Contact">
            {%- if section.settings.contact_phone != blank -%}
              <a href="tel:{{ section.settings.contact_phone }}" class="footer__link footer__link--icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
