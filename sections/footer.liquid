<style>
  .site-footer {
    background-color: #f5f0e8;
    color: #3a3a3a;
  }

  .footer__most-searched {
    background: #1a1a1a;
    padding: var(--space-lg) 0;
    color: #999;
    margin: 0;
  }

  .footer__most-searched summary {
    list-style: none;
    cursor: pointer;
  }

  .footer__most-searched summary::-webkit-details-marker {
    display: none;
  }

  .footer__most-searched-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
  }

  .footer__most-searched-title {
    font-family: var(--font-accent);
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer__most-searched-icon {
    color: #fff;
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
  }

  .footer__most-searched-icon svg {
    width: 14px;
    height: 14px;
  }

  .footer__most-searched[open] .footer__most-searched-icon {
    transform: rotate(180deg);
  }

  .footer__most-searched-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    line-height: 1.6;
  }

  .footer__most-searched-links a {
    color: #999;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 10px;
    transition: color 0.2s;
  }

  .footer__most-searched-links a:hover {
    color: #fff;
  }

  .site-footer .footer__bottom-bar {
    border-top: 1px solid #dcc6b0;
    padding: var(--space-xl) 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .footer__social-heading {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    color: #1a2a3a;
    margin: 0 0 12px;
  }

  .footer__social-icons {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: #fff;
    color: #1a2a3a;
    transition: all 0.2s ease;
  }

  .footer__social-link svg *,
  .footer__social-link svg path,
  .footer__social-link svg rect,
  .footer__social-link svg polygon,
  .footer__social-link svg circle {
    fill: currentColor !important;
    stroke: none !important;
  }

  .footer__social-link svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .footer__social-link:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: #fff;
    transform: translateY(-2px);
  }

  .footer__bottom-right {
    text-align: right;
    max-width: 500px;
  }

  .site-footer .footer__copyright {
    font-size: 11px;
    color: #555;
    margin: 0 0 6px;
    font-weight: 500;
  }

  .footer__full-address {
    font-size: 10px;
    color: #888;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .site-footer .footer__bottom-bar {
      flex-direction: column;
      text-align: left;
      gap: 24px;
    }
    .footer__bottom-right {
      text-align: left;
    }
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    padding: var(--space-3xl) 0 var(--space-2xl);
    align-items: start;
  }


  .footer__column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .footer__logo {
    margin-bottom: 20px;
  }

  .footer__logo img {
    max-height: 50px;
    width: auto;
  }

  .footer__brand-text {
    font-size: 12px;
    color: #555;
    line-height: 1.7;
    margin: 0;
    max-width: 220px;
  }

  .footer__heading {
    font-size: 13px;
    font-weight: 700;
    color: #1a2a3a;
    margin: 0 0 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--font-heading);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 10px;
    width: 100%;
  }

  .footer__link {
    font-size: 12px;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
    line-height: 1.4;
  }

  .footer__link:hover {
    color: #1a2a3a;
  }

  .footer__link--icon {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer__link--icon svg {
    flex-shrink: 0;
    opacity: 0.55;
    color: #3a3a3a;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
    .footer__brand {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
      padding: var(--space-2xl) 0 var(--space-lg);
      text-align: left;
    }
    .footer__brand {
      align-items: flex-start;
      display: flex;
      flex-direction: column;
      margin-bottom: var(--space-sm);
      width: 100%;
      grid-column: span 2;
    }
    .footer__column {
      align-items: flex-start;
      display: flex;
      flex-direction: column;
    }
    .footer__logo {
      display: block;
      text-align: left;
      margin: 0 0 12px;
      width: 100%;
    }
    .footer__logo img {
      display: block;
      margin: 0;
      max-width: 160px;
      width: auto;
      height: auto;
    }
    .footer__brand-text {
      margin: 0;
      max-width: 280px;
      text-align: left;
    }
    .footer__links {
      align-items: flex-start;
    }
    .footer__link--icon {
      justify-content: flex-start;
    }
    .footer__heading {
      text-align: left;
      margin-bottom: 10px;
    }
    /* Hide empty Contact section on mobile when no links are configured */
    .footer__column .footer__links:empty {
      display: none;
    }
  }
</style>

