{%- comment -%}
  Hero Banner — Carousel
  Each block = one slide. Supports asset_name, subtitle, heading, description, button.
{%- endcomment -%}

<section class="hero-carousel" id="hero-banner">
  <div class="hero-carousel__track" id="heroCarouselTrack">
    {%- for block in section.blocks -%}
      <div class="hero-carousel__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        <div class="hero-carousel__media">
          {%- if block.settings.asset_name != blank -%}
            <img
              src="{{ block.settings.asset_name | asset_url }}"
              alt="{{ block.settings.heading | default: section.settings.heading | escape }}"
              width="2000"
              height="800"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          {%- else -%}
            <div class="hero-carousel__placeholder"></div>
          {%- endif -%}
        </div>
        <div class="hero-carousel__overlay"></div>
        <div class="hero-carousel__content">
          {%- if block.settings.subtitle != blank -%}
            <p class="hero-carousel__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h1 class="hero-carousel__title">{{ block.settings.heading }}</h1>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="hero-carousel__description">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.button_text != blank -%}
            <a href="{{ block.settings.button_url | default: '/collections' }}" class="hero-carousel__btn">
              {{ block.settings.button_text }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hero-carousel__arrow hero-carousel__arrow--prev" aria-label="Previous slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="hero-carousel__arrow hero-carousel__arrow--next" aria-label="Next slide">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="hero-carousel__dots">
      {%- for block in section.blocks -%}
        <button class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #1a1008;
  }

  .hero-carousel__track {
    display: grid;
    width: 100%;
  }

  .hero-carousel__slide {
    grid-area: 1 / 1;
    min-height: 720px;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .hero-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-carousel__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-carousel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-carousel__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #2c1810 0%, #4a3728 30%, #6b5a4e 60%, #8b7355 80%, #c9a96e 100%);
  }

  .hero-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 60%, rgba(0,0,0,0.1) 100%);
    z-index: 1;
  }

  .hero-carousel__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 60px 80px;
    color: #fff;
    text-align: center;
  }

  .hero-carousel__subtitle {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a96e;
    margin: 0 0 16px;
  }

  .hero-carousel__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(28px, 3.2vw, 48px);
    font-weight: 600;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 20px;
  }

  .hero-carousel__description {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255,255,255,0.85);
    margin: 0 0 32px;
  }

  .hero-carousel__btn {
    display: inline-block;
    padding: 14px 32px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.7);
    color: #fff;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .hero-carousel__btn:hover {
    background: #fff;
    border-color: #fff;
    color: #1a1008;
  }

  /* Arrows */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
  }
  .hero-carousel__arrow:hover {
    background: rgba(255,255,255,0.3);
  }
  .hero-carousel__arrow--prev { left: 20px; }
  .hero-carousel__arrow--next { right: 20px; }

  /* Dots */
  .hero-carousel__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 8px;
  }
  .hero-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .hero-carousel__dot.is-active {
    background: #fff;
    transform: scale(1.3);
  }

  @media screen and (max-width: 768px) {
    .hero-carousel__slide { min-height: 560px; }
    .hero-carousel__content { padding: 60px 24px; }
    .hero-carousel__arrow { width: 36px; height: 36px; }
    .hero-carousel__arrow--prev { left: 10px; }
    .hero-carousel__arrow--next { right: 10px; }
  }
</style>

<script>
(function () {
  var carousel = document.getElementById('hero-banner');
  if (!carousel) return;

  var slides = carousel.querySelectorAll('.hero-carousel__slide');
  var dots   = carousel.querySelectorAll('.hero-carousel__dot');
  var prev   = carousel.querySelector('.hero-carousel__arrow--prev');
  var next   = carousel.querySelector('.hero-carousel__arrow--next');
  var current = 0;
  var total   = slides.length;
  var timer;

  if (total <= 1) return;

  function goTo(index) {
    slides[current].classList.remove('is-active');
    dots[current] && dots[current].classList.remove('is-active');
    current = (index + total) % total;
    slides[current].classList.add('is-active');
    dots[current] && dots[current].classList.add('is-active');
  }

  function startAuto() {
    timer = setInterval(function () { goTo(current + 1); }, 5000);
  }

  function resetAuto() {
    clearInterval(timer);
    startAuto();
  }

  if (prev) prev.addEventListener('click', function () { goTo(current - 1); resetAuto(); });
  if (next) next.addEventListener('click', function () { goTo(current + 1); resetAuto(); });

  dots.forEach(function (dot, i) {
    dot.addEventListener('click', function () { goTo(i); resetAuto(); });
  });

  startAuto();
})();
</script>

{% schema %}
{
  "name": "Hero Banner",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "asset_name",
          "label": "Image filename (e.g. home_1.jpg)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
