                  {%- when 'Diffusion Treated (Colour surface modification)' -%}
                    {%- assign faq_treatment_answer = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
                  {%- when 'Glass-Filled (Fracture-filled to improve clarity)' -%}
                    {%- assign faq_treatment_answer = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
                  {%- when 'Resin-Filled / Dyed' -%}
                    {%- assign faq_treatment_answer = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
                  {%- when 'Wax Filled' -%}
                    {%- assign faq_treatment_answer = 'This gem is generally not considered astrologically suitable and more suited for jewellery purposes. However please consult your astrologer if you wish to buy this gem.' -%}
                  {%- when 'Ethiopian Opals' -%}
