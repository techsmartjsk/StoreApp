{%- comment -%}Main Product Section{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%} Removed- [x] Overhaul Customization Modal UI in `main-product.liquid`
    - [x] Create horizontal icon selection for Ring/Pendant/Bracelet
    - [x] Create Metal selection dropdown
    - [x] Create Design Grid with images and prices
- [x] Add Customization Styles to `sections.css`
    - [x] Design the horizontal row and grid layout
    - [x] Match typography and colors from reference image
- [x] Implement Dynamic Pricing Logic
    - [x] Create `updateTotalPrice()` in `main-product.liquid` scripts
    - [x] Update `CustomizeApp.set()` to track fees for each selection
    - [x] Link certification fee selection to the total price
- [x] Implement Cart Integration
    - [x] Add AJAX "parallel add" for customization fees
    - [x] Ensure linked line item properties in `main-product.liquid` / `theme.js`
    - [x] Add JS to handle certification fee updates
    - [x] Add form submission interceptors for cart attributes {%- endcomment -%}

<section class="product-page" id="product-{{ product.id }}">
  <div class="page-width">
    <!-- Breadcrumb moved here -->
    <nav class="breadcrumb breadcrumb--pdp" aria-label="breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">›</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
        <span class="breadcrumb__sep">›</span>
      {%- endif -%}
      <a href="{{ product.url }}">{{ product.title }}</a>
    </nav>

    <div class="product-page__wrapper">

      <!-- Gallery -->
      <div class="product-page__gallery">

        <!-- Vertical thumbnail strip -->
        <div class="product-page__thumbstrip">
          {%- for media in product.media -%}
            <button
              class="product-page__thumb{% if forloop.first %} product-page__thumb--active{% endif %}"
              onclick="openVideoFromThumb('{{ media.id }}', this)"
              aria-label="View {{ media.media_type | replace: '_', ' ' }} {{ forloop.index }}"
              data-media-id="{{ media.id }}"
            >
              {%- if media.media_type contains 'video' -%}
                <div class="product-page__thumb-video-icon">
                  {% render 'icon', name: 'play' %}
                </div>
              {%- endif -%}
              <img
                src="{{ media.preview_image | image_url: width: 120 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
          {%- if product.metafields.custom.video != blank -%}
            {%- assign mf_video_urls = product.metafields.custom.video | split: ',' -%}
            {%- for mf_video_url in mf_video_urls -%}
              {%- assign mf_video_url_clean = mf_video_url | strip -%}
              {%- assign mf_vimeo_id_thumb = mf_video_url_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
              {%- assign mf_video_idx = forloop.index0 -%}
              <button
                class="product-page__thumb"
                onclick="openVideoFromThumb('metafield-video-{{ mf_video_idx }}', this)"
                aria-label="View video"
                data-media-id="metafield-video-{{ mf_video_idx }}"
              >
                <div class="product-page__thumb-video-icon">
                  {% render 'icon', name: 'play' %}
                </div>
                <img
                  src="https://vumbnail.com/{{ mf_vimeo_id_thumb }}.jpg"
                  alt="Video {{ forloop.index }}"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Action icons (between thumbs and image) -->
        <div class="product-page__img-actions">
          <button class="product-page__img-action-btn" aria-label="Share" onclick="copyToClipboard(window.location.href, this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
          <button 
            class="product-page__img-action-btn" 
            aria-label="Wishlist"
            data-wishlist-toggle
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-url="{{ product.url }}"
            data-product-price="{{ product.price | money }}"
            data-variant-price="{{ product.selected_or_first_available_variant.price }}"
            data-product-image="{{ product.featured_image | image_url: width: 600 }}"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            onclick="event.preventDefault(); WishlistApp.toggle(this)"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
          <button
            type="button"
            class="product-page__img-action-btn product-page__compare-btn"
            aria-label="Add to compare"
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            data-product-title="{{ product.title | escape }}"
            data-product-url="{{ product.url }}"
            data-product-price="{{ product.price | money }}"
            data-product-image="{{ product.featured_image | image_url: width: 600 }}"
            data-variant-id="{{ current_variant.id }}"
            data-product-type="{{ product.type | escape }}"
            data-product-vendor="{{ product.vendor | escape }}"
            data-gem-type="{{ product.metafields.custom.gem_type | default: product.type | escape }}"
            data-gem-origin="{{ product.metafields.custom.origin | escape }}"
            data-gem-weight-carats="{{ product.metafields.custom.weight_carats }}"
            data-gem-weight-ratti="{{ product.metafields.custom.weight_ratti }}"
            data-gem-shape-cut="{{ product.metafields.custom.shape_cut | escape }}"
            data-gem-cutting-style="{{ product.metafields.custom.cutting_style | escape }}"
            data-gem-transparency="{{ product.metafields.custom.transparency | escape }}"
            data-gem-color="{{ product.metafields.custom.color_description | escape }}"
            data-gem-planet="{{ product.metafields.custom.planetary_alignment | escape }}"
            data-gem-cert-lab="{{ product.metafields.custom.cert_lab | escape }}"
            data-gem-cert-number="{{ product.metafields.custom.cert_number | escape }}"
            data-gem-cert-link="{{ product.metafields.custom.cert_link | escape }}"
            data-gem-treatment="{{ product.metafields.custom.treatment_status | escape }}"
            data-gem-dimensions="{{ product.metafields.custom.dimensions | escape }}"
            data-gem-species="{{ product.metafields.custom.gems_title | escape }}"
            onclick="event.preventDefault(); CompareApp.toggle(this)"
          >
            <img src="{{ 'balance.svg' | asset_url }}" alt="" width="16" height="16">
          </button>
          {% comment %}<button class="product-page__img-action-btn" aria-label="Zoom" onclick="zoomActiveImage()">
            <img src="{{ 'zoom-in.svg' | asset_url }}" alt="Zoom" style="width: 16px; height: 16px; object-fit: contain;">
          </button>{% endcomment %}
        </div>

        <!-- Main image -->
        <div class="product-page__main-img-wrap">
          <!-- Certification logos overlaid on image -->
          {% comment %} <div class="product-page__cert-logos">
            {%- if section.settings.cert_logo != blank -%}
              <img src="{{ section.settings.cert_logo | image_url: width: 160 }}" alt="Certification" class="product-page__cert-logo product-page__cert-logo--left">
            {%- endif -%}
          </div> {% endcomment %}

          {% comment %}<!-- Zoom highlight lens -->
          <div class="product-page__zoom-lens" id="zoom-lens"></div>{% endcomment %}

          <div id="product-page-media-container">
            {%- if product.featured_media -%}
              {%- for media in product.media -%}
                <div class="product-page__media-item {% if media.id == product.featured_media.id %}is-active{% endif %}" data-media-id="{{ media.id }}" style="display: {% if media.id == product.featured_media.id %}block{% else %}none{% endif %};">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1000 }}"
                        data-zoom-src="{{ media | image_url: width: 2000 }}"
                        alt="{{ media.alt | default: product.title | escape }}"
                        class="product-page__main-img"
                        id="main-product-image-{{ media.id }}"
                      >
                    {%- when 'external_video' -%}
                      <div class="product-page__video-preview" data-video-type="external" data-media-id="{{ media.id }}"
                        {%- if media.host == 'youtube' %} data-video-url="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=1"{% endif -%}
                        {%- if media.host == 'vimeo' %} data-video-url="https://player.vimeo.com/video/{{ media.external_id }}?autoplay=1&outro=nothing"{% endif -%}
                        onclick="openVideoPopup(this)">
                        <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }}" class="product-page__main-img" loading="lazy">
                        <div class="product-page__video-play-btn">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        </div>
                      </div>
                    {%- when 'video' -%}
                      <div class="product-page__video-preview" data-video-type="native" data-media-id="{{ media.id }}" onclick="openVideoPopup(this)">
                        <img src="{{ media.preview_image | image_url: width: 1000 }}" alt="{{ media.alt | default: product.title | escape }}" class="product-page__main-img" loading="lazy">
                        <div class="product-page__video-play-btn">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        </div>
                        <video class="product-page__video-source" style="display:none;" preload="metadata">
                          {%- for source in media.sources -%}
                            <source src="{{ source.url }}" type="{{ source.mime_type }}">
                          {%- endfor -%}
                        </video>
                      </div>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
              {%- if product.metafields.custom.video != blank -%}
                {%- assign mf_video_urls_main = product.metafields.custom.video | split: ',' -%}
                {%- for mf_video_url_main in mf_video_urls_main -%}
                  {%- assign mf_video_url_main_clean = mf_video_url_main | strip -%}
                  {%- assign mf_vimeo_id_main = mf_video_url_main_clean | split: 'vimeo.com/' | last | split: '?' | first -%}
                  <div class="product-page__media-item" data-media-id="metafield-video-{{ forloop.index0 }}" style="display:none;">
                    <div class="product-page__video-preview" data-video-type="external" data-video-url="https://player.vimeo.com/video/{{ mf_vimeo_id_main }}?autoplay=1&outro=nothing" onclick="openVideoPopup(this)">
                      <img src="https://vumbnail.com/{{ mf_vimeo_id_main }}.jpg" alt="Video {{ forloop.index }}" class="product-page__main-img" loading="lazy">
                      <div class="product-page__video-play-btn">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                      </div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              <div class="product-page__img-placeholder">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
          </div>
        </div>


        <!-- Share with a friend (desktop only — hidden on mobile) -->
        <div class="product-share product-share--gallery" style="grid-column: 1 / -1;">
          <span class="product-share__label">Share with a friend</span>
          <div class="product-share__buttons">
            <a
              class="product-share__btn product-share__btn--whatsapp"
              href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url }}{{ product.url }}"
              target="_blank"
              rel="noopener"
              aria-label="Share on WhatsApp"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
            <a
              class="product-share__btn product-share__btn--instagram"
              href="https://www.instagram.com/"
              target="_blank"
              rel="noopener"
              aria-label="Share on Instagram"
              onclick="copyShareLink(event)"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              Instagram
            </a>
            <a
              class="product-share__btn product-share__btn--email"
              href="mailto:?subject={{ product.title | url_encode }}&body=Check%20out%20this%20gem%3A%20{{ shop.url }}{{ product.url }}"
              aria-label="Share via Email"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
              Email
            </a>
            <button
              class="product-share__btn product-share__btn--copy"
              onclick="copyShareLink(event)"
              aria-label="Copy link"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              Copy Link
            </button>
          </div>
        </div>

        <!-- Below Gallery Block Slot -->
        {%- assign _app_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'below_gallery' -%}
            <div class="product-page__custom-block" style="grid-column: 1 / -1;" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>
          {%- elsif block.type == '@app' -%}
            {%- assign _app_idx = _app_idx | plus: 1 -%}
            {%- if _app_idx == 1 -%}
              <div class="product-page__custom-block product-page__app-block--gallery" style="grid-column: 1 / -1;" {{ block.shopify_attributes }}>
                {%- render block -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

      </div>

      {% comment %}<!-- Zoom result panel (Amazon-style, positioned over info area) -->
      <div class="product-page__zoom-result" id="zoom-result"></div>{% endcomment %}

      <!-- Product Info -->
      <div class="product-page__info">

        <!-- Vendor -->
        {%- if product.vendor -%}
          <p class="product-page__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <!-- Title + badges row -->
        <div class="product-page__title-row">
          <h1 class="product-page__title">{{ product.title }}</h1>
        </div>

        <!-- SKU / Origin / Reviews -->
        <div class="product-page__meta-row">
          <span>SKU: {{ product.metafields.custom.sku_number | default: '87587' }}</span>
          <span class="product-page__meta-sep">|</span>
          <span>Origin: {{ product.metafields.custom.origin | default: 'Ceylon / Sri Lanka' }}</span>
          {%- if product.metafields.custom.weight_carats != blank -%}
            <span class="product-page__meta-sep">|</span>
            <span>Weight: {{ product.metafields.custom.weight_carats }} Carat</span>
          {%- endif -%}
        </div>

        <div class="product-page__divider"></div>

        <!-- Price -->
        <div class="product-page__price-wrap">
          <div class="product-page__price-row">
            {%- if product.price > 100000000 -%}
              <span class="product-page__price">Request Price</span>
            {%- else -%}
              <span class="product-page__price">{{ current_variant.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="product-page__compare-price">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
              <span class="product-page__price-note">(MRP incl. of all taxes)</span>
            {%- endif -%}
          </div>
          <div class="product-page__price-widget" id="product-price-widget">
            {%- if section.settings.payu_merchant_key != blank -%}
              <div id="payu-affordability-widget"></div>
            {%- endif -%}
          </div>
        </div>

        <div class="product-page__divider"></div>

        <!-- Tabs -->
        <div class="product-page__tabs">
          <div class="product-page__tab-nav" role="tablist">
            <button class="product-page__tab-btn product-page__tab-btn--active" onclick="switchTab('about', this)" role="tab">About this Gem</button>
            <button class="product-page__tab-btn" onclick="switchTab('know-gem', this)" role="tab">Know your gem</button>
            <button class="product-page__tab-btn" onclick="switchTab('planetary', this)" role="tab">Planetary Alignment</button>
            <button class="product-page__tab-btn" onclick="switchTab('faqs', this)" role="tab">FAQs</button>
            {%- if product.price >= 50000000 -%}
              <button class="product-page__tab-btn" onclick="switchTab('special', this)" role="tab">Why this gem is special</button>
            {%- endif -%}
          </div>
          <div class="product-page__tab-pane product-page__tab-pane--active" id="tab-about">
            <div class="product-page__tab-pane-inner">
            {%- if product.metafields.custom.tagline != blank or product.metafields.custom.tagline_hindi != blank -%}
              <div class="product-page__taglines">
                {% if product.metafields.custom.tagline %}<p class="product-page__tagline-en">{{ product.metafields.custom.tagline }}</p>{% endif %}
                {% if product.metafields.custom.tagline_hindi %}<p class="product-page__tagline-hi">{{ product.metafields.custom.tagline_hindi }}</p>{% endif %}
              </div>
            {%- endif -%}

            {%- if product.metafields.custom.editorial != blank -%}
              <div class="product-page__description">
                {{ product.metafields.custom.editorial | newline_to_br }}
              </div>
            {%- elsif product.description != blank -%}
              <div class="product-page__description">
                {{ product.description }}
              </div>
            {%- else -%}
              <h4 class="product-page__tab-heading">About this Gem</h4>
              <p>Discover the unique story and origin of this natural {{ product.type | default: 'gemstone' }}. Each piece in our collection is handpicked for its exceptional clarity, vibrant color, and sacred energy.</p>
            {%- endif -%}

            <!-- Specs Grid -->
            <div class="product-page__specs-grid">
              <div class="product-page__spec-item">
                <span class="product-page__spec-label">Gem Type</span>
                <span class="product-page__spec-value">{{ product.metafields.custom.gem_type | default: 'Blue Sapphire' }}</span>
              </div>
              <div class="product-page__spec-item">
                <span class="product-page__spec-label">Origin</span>
                <span class="product-page__spec-value">{{ product.metafields.custom.origin | default: 'Ceylon / Sri Lanka' }}</span>
              </div>
              <div class="product-page__spec-item">
                <span class="product-page__spec-label">Weight</span>
                <span class="product-page__spec-value">
                  {% if product.metafields.custom.weight_carats %}{{ product.metafields.custom.weight_carats }} Carat{% else %}6.02 Carat{% endif %} /
                  {% if product.metafields.custom.weight_ratti %}{{ product.metafields.custom.weight_ratti | times: 1.0 | round: 2 }} Ratti{% else %}6.68 Ratti{% endif %}
                </span>
              </div>
              <div class="product-page__spec-item">
                <span class="product-page__spec-label">Shape / Cut</span>
                <span class="product-page__spec-value">
                  {{ product.metafields.custom.shape_cut | default: 'Oval' }} ({{ product.metafields.custom.cutting_style | default: 'Mixed Cut' }})
                </span>
              </div>
              {%- if product.metafields.custom.shape_description != blank -%}
                <div class="product-page__spec-item product-page__spec-item--full">
                  <span class="product-page__spec-label">Shape Description</span>
                  <span class="product-page__spec-value">{{ product.metafields.custom.shape_description }}</span>
                </div>
              {%- endif -%}
              <div class="product-page__spec-item">
                <span class="product-page__spec-label">Transparency</span>
                <span class="product-page__spec-value">{{ product.metafields.custom.transparency | default: 'Transparent' }}</span>
              </div>
              {%- if product.metafields.custom.color_description != blank -%}
                <div class="product-page__spec-item">
                  <span class="product-page__spec-label">Color</span>
                  <span class="product-page__spec-value">{{ product.metafields.custom.color_description }}</span>
