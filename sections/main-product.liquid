<script>
  function setMainMedia(mediaId, btn) {
    document.querySelectorAll('.product-page__media-item').forEach(item => {
      item.style.display = 'none';
      item.classList.remove('is-active');
    });

    const selectedMedia = document.querySelector(`.product-page__media-item[data-media-id="${mediaId}"]`);
    if (selectedMedia) {
      selectedMedia.style.display = 'block';
      selectedMedia.classList.add('is-active');
    }
    document.querySelectorAll('.product-page__thumb').forEach(t => t.classList.remove('product-page__thumb--active'));
    btn.classList.add('product-page__thumb--active');
  }

  /** Thumbnail click: images swap main media; videos swap then open the popup (same as main preview tap). */
  function openVideoFromThumb(mediaId, btn) {
    var wrap = document.querySelector('.product-page__media-item[data-media-id="' + mediaId + '"]');
    var preview = wrap ? wrap.querySelector('.product-page__video-preview') : null;
    if (preview) {
      setMainMedia(mediaId, btn);
      openVideoPopup(preview);
    } else {
      setMainMedia(mediaId, btn);
    }
  }

  function triggerProductBuyNow(ev) {
    var customizeEl = document.getElementById('cta-customize');
    var useCustomize = customizeEl && window.getComputedStyle(customizeEl).display !== 'none';
    var container = useCustomize ? customizeEl : document.getElementById('cta-default');
    if (typeof handleFloBuyNowBtn === 'function') {
      handleFloBuyNowBtn(ev);
      return;
    }
    var btn = container ? container.querySelector('.shopify-payment-button__button--unbranded') : null;
    if (!btn) btn = document.querySelector('#product-{{ product.id }} .shopify-payment-button__button--unbranded');
    if (btn) btn.click();
  }

  function switchTab(tabId, btn) {
    document.querySelectorAll('.product-page__tab-pane').forEach(p => p.classList.remove('product-page__tab-pane--active'));
    document.querySelectorAll('.product-page__tab-btn').forEach(b => b.classList.remove('product-page__tab-btn--active'));
    const pane = document.getElementById('tab-' + tabId);
    if (pane) pane.classList.add('product-page__tab-pane--active');
    btn.classList.add('product-page__tab-btn--active');
  }

  function updateCertFee(select) {
    const option = select.options[select.selectedIndex];
    const feeInPaise = parseInt(option.getAttribute('data-fee')) || 0;
    const note = document.getElementById('cert-fee-note-{{ section.id }}');
    
    if (feeInPaise > 0) {
      const feeFormatted = (feeInPaise / 100).toLocaleString('en-IN', {
        style: 'currency',
        currency: 'INR',
        minimumFractionDigits: 0
      });
      note.textContent = `+ ${feeFormatted} Certification Fee`;
      note.style.display = 'block';
    } else {
      note.style.display = 'none';
      note.textContent = '';
    }
    
    // Update global state for price calculation
    CustomizeApp.state.certFee = feeInPaise;
    CustomizeApp.updateTotalPrice();
    updateDispatchDate();
  }

  // ---- Estimated dispatch date ----
  // Rules: T = today.
  //   Normal order            -> T + 1
  //   Any customisation       -> T + 4
  //   Any gold customisation  -> T + 5
  //   Certificate selected    -> adds the certificate's stated extra days (+ the base above)
  function getCertExtraDays() {
    const sel = document.getElementById('CertificationField-{{ section.id }}');
    if (!sel || sel.selectedIndex < 0) return 0;
    const opt = sel.options[sel.selectedIndex];
    return parseInt(opt && opt.getAttribute('data-days')) || 0;
  }

  function updateDispatchDate() {
    const el = document.getElementById('dispatch-date-{{ section.id }}');
    if (!el) return;
    const st = CustomizeApp.state;

    let baseDays = 1; // normal order: T + 1
    if (st.customized) {
      const isGold = /gold/i.test(st.metal || '');
      baseDays = isGold ? 5 : 4; // gold customisation: T + 5, any customisation: T + 4
    }

    const totalDays = baseDays + getCertExtraDays();
    const d = new Date();
    d.setDate(d.getDate() + totalDays);
    el.textContent = d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  document.addEventListener('DOMContentLoaded', updateDispatchDate);

  (function initProductRingSizing() {
    var sectionId = '{{ section.id }}';

    function fillUsRingSizes() {
      var sel = document.getElementById('RingSizeUs-' + sectionId);
      if (!sel || sel.dataset.pcFilled) return;
      sel.dataset.pcFilled = '1';
      for (var v = 0.5; v <= 16.001; v += 0.5) {
        var opt = document.createElement('option');
        opt.value = String(v);
        var display = (v % 1 === 0) ? String(v) : v.toFixed(1);
        opt.textContent = 'US size ' + display;
        sel.appendChild(opt);
      }
    }

    function clearRingSizingError() {
      var el = document.getElementById('ring-sizing-error-' + sectionId);
      if (el) el.textContent = '';
    }

    function setRingSizingError(msg) {
      var el = document.getElementById('ring-sizing-error-' + sectionId);
      if (el) el.textContent = msg || '';
    }

    function updateSecondRow() {
      var sysEl = document.getElementById('RingSizeSystem-' + sectionId);
      var row = document.getElementById('RingSizeSecondRow-' + sectionId);
      if (!sysEl || !row) return;
      var sys = sysEl.value;
      clearRingSizingError();
      if (sys === 'later') {
        row.style.display = 'none';
        return;
      }
      row.style.display = '';
      ['indian', 'us', 'inner'].forEach(function(key) {
        var panel = document.querySelector('#product-ring-sizing-' + sectionId + ' [data-ring-panel="' + key + '"]');
        if (!panel) return;
        panel.style.display = (sys === key) ? '' : 'none';
      });
      if (sys === 'us') fillUsRingSizes();
    }

    window.getProductRingSizingCartProperties = function(sid) {
      sid = sid || sectionId;
      var sysEl = document.getElementById('RingSizeSystem-' + sid);
      if (!sysEl) return {};
      var sys = sysEl.value;
      if (sys === 'later') {
        return {
          'Ring size system': "Later / Don't know",
          'Ring size detail': 'To be confirmed with customer'
        };
      }
      var out = {};
      if (sys === 'indian') {
        out['Ring size system'] = 'Indian Ring Size System';
        var iv = document.getElementById('RingSizeIndian-' + sid);
        var ind = iv ? iv.value : '';
        out['Ring size detail'] = ind ? ('Indian size ' + ind) : '';
        out['Indian ring size'] = ind || '';
      } else if (sys === 'us') {
        out['Ring size system'] = 'US Ring Size System';
        var uv = document.getElementById('RingSizeUs-' + sid);
        var us = uv ? uv.value : '';
        out['Ring size detail'] = us ? ('US size ' + us) : '';
        out['US ring size'] = us || '';
      } else if (sys === 'inner') {
        out['Ring size system'] = 'Inner circumference (mm)';
        var mmEl = document.getElementById('RingSizeInnerMm-' + sid);
        var mm = mmEl ? String(mmEl.value || '').trim() : '';
        out['Ring size detail'] = mm ? (mm + ' mm inner circumference') : '';
        out['Inner circumference (mm)'] = mm || '';
      }
      return out;
    };

    window.validateProductRingSizing = function(sid) {
      sid = sid || sectionId;
      var sysEl = document.getElementById('RingSizeSystem-' + sid);
      if (!sysEl) return true;
      clearRingSizingError();
      var sys = sysEl.value;
      if (sys === 'later') return true;
      if (sys === 'indian') {
        var iv = document.getElementById('RingSizeIndian-' + sid);
        if (!iv || !iv.value) {
          setRingSizingError('Please select a ring size.');
          return false;
        }
        return true;
      }
      if (sys === 'us') {
        var uv = document.getElementById('RingSizeUs-' + sid);
        if (!uv || !uv.value) {
          setRingSizingError('Please select a ring size.');
          return false;
        }
        return true;
      }
      if (sys === 'inner') {
        var mmEl = document.getElementById('RingSizeInnerMm-' + sid);
        var mm = mmEl ? parseFloat(mmEl.value) : NaN;
        if (!mmEl || mmEl.value === '' || isNaN(mm) || mm <= 0) {
          setRingSizingError('Please enter inner circumference in mm.');
          return false;
        }
        return true;
      }
      return true;
    };

    function syncRingSizingHiddenIntoForm(form) {
      if (!form) return;
      form.querySelectorAll('input[data-pc-ring-sync]').forEach(function(n) { n.remove(); });
      var props = window.getProductRingSizingCartProperties(sectionId);
      Object.keys(props).forEach(function(key) {
        var inp = document.createElement('input');
        inp.type = 'hidden';
        inp.name = 'properties[' + key + ']';
        inp.value = props[key];
        inp.setAttribute('data-pc-ring-sync', '1');
        form.appendChild(inp);
      });
    }

    window.syncProductRingSizingToProductForms = function() {
      document.querySelectorAll('form[action*="/cart/add"]').forEach(syncRingSizingHiddenIntoForm);
    };

    document.addEventListener('DOMContentLoaded', function() {
      var sysEl = document.getElementById('RingSizeSystem-' + sectionId);
      if (sysEl) {
        sysEl.addEventListener('change', updateSecondRow);
        updateSecondRow();
        fillUsRingSizes();
      }

      var tries = 0;
      var timer = setInterval(function() {
        tries++;
        if (typeof window.handleFloBuyNowBtn === 'function' && !window.__pcFloBuyNowWrapped) {
          window.__pcFloBuyNowWrapped = true;
          clearInterval(timer);
          var orig = window.handleFloBuyNowBtn;
          window.handleFloBuyNowBtn = function(ev) {
            if (!window.validateProductRingSizing(sectionId)) {
              if (ev && ev.preventDefault) ev.preventDefault();
              return false;
            }
            window.syncProductRingSizingToProductForms();
            return orig.apply(this, arguments);
          };
        }
        if (tries > 50) clearInterval(timer);
      }, 200);
    });
  })();

  // Intercept Add to Cart to include Certification properties and parallel items
  document.addEventListener('DOMContentLoaded', function() {
    const productForms = document.querySelectorAll('form[action^="/cart/add"]');
    
    productForms.forEach(form => {
      form.addEventListener('submit', function(e) {
        const certSelect = document.getElementById('CertificationField-{{ section.id }}');
        const certVal = certSelect ? certSelect.value : 'None';
        
        // Parallel Add Logic
        if (e.cancelable) e.preventDefault();
        if (typeof window.validateProductRingSizing === 'function' && !window.validateProductRingSizing('{{ section.id }}')) {
          return;
        }
        const itemsToCart = [];
        
        // 1. Gemstone Product
        const variantIdInput = form.querySelector('[name="id"]');
        if (!variantIdInput) return;

        itemsToCart.push({
          id: variantIdInput.value,
          quantity: 1,
          properties: {
            {% if product.metafields.custom.weight_carats != blank %}
            'Weight': '{{ product.metafields.custom.weight_carats | escape }} Carat',
            {% elsif product.metafields.custom.weight_ratti != blank %}
            'Weight (Ratti)': '{{ product.metafields.custom.weight_ratti | times: 1.0 | round: 2 | escape }} Ratti',
            {% endif %}
            'Origin': '{{ product.metafields.custom.origin | default: "Ceylon / Sri Lanka" | escape }}',
            'Gem Type': '{{ product.metafields.custom.gem_type | default: product.type | escape }}',
            'Certification': certVal,
            '_certification_lab': '{{ product.metafields.custom.cert_lab | escape }}',
            'Shape / Cut': '{{ product.metafields.custom.shape_cut | escape }}',
            'Treatment': '{{ product.metafields.custom.treatment_status | escape }}',
            'Jewelry Type': CustomizeApp.state.type || 'None',
            'Metal': CustomizeApp.state.metal || 'None',
            'Style': CustomizeApp.state.style || 'None',
            '_customization_fee_raw': CustomizeApp.state.certFee + CustomizeApp.state.metalFee + CustomizeApp.state.styleFee,
            '_master_id': Date.now()
          }
        });

        const ringProps = (typeof window.getProductRingSizingCartProperties === 'function')
          ? window.getProductRingSizingCartProperties('{{ section.id }}') : {};
        Object.assign(itemsToCart[0].properties, ringProps);

        // Check if "Buy It Now" was clicked
        const isBuyNow = e.submitter && (e.submitter.hasAttribute('data-buy-now') || e.submitter.name === 'checkout');

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: itemsToCart })
        })
        .then(res => res.json())
        .then(() => {
          const btn = form.querySelector('button[type="submit"]:not([data-buy-now])');
          if (btn && !isBuyNow) {
            const originalText = btn.innerHTML;
            btn.innerHTML = '✓ ADDED TO CART';
            btn.style.backgroundColor = '#27ae60';
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.style.backgroundColor = '';
              window.location.href = '/cart';
            }, 1000);
          } else {
            window.location.href = isBuyNow ? '/checkout' : '/cart';
          }
        })
        .catch(err => {
          console.error("Cart Error:", err);
          form.submit();
        });
      });
    });
  });

