<style>
  /* Breadcrumb */
  .product-breadcrumb {
    background: var(--color-bg, #faf8f4);
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border-light, #eee);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 11px;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: #888;
  }

  .breadcrumb a {
    color: #888;
    text-decoration: none;
  }

  .breadcrumb a:hover { color: var(--color-primary, #1a2a3a); }
  .breadcrumb__sep { color: #bbb; }

  .breadcrumb--pdp {
    margin-bottom: 20px;
  }

  /* Page wrapper */
  .product-page { padding: var(--space-2xl, 40px) 0 var(--space-4xl, 80px); }

  @media (max-width: 768px) {
    .product-page { padding: var(--space-xl, 24px) 16px var(--space-3xl, 60px); }
  }

  .product-page__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: flex-start;
    width: 100%;
  }

  /* Gallery */
  .product-page__gallery {
    display: grid;
    grid-template-columns: 70px 36px 1fr;
    gap: 12px;
    padding-right: 32px;
    width: 100%;
  }

  /* Thumbnail strip */
  .product-page__thumbstrip {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 580px;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .product-page__thumbstrip::-webkit-scrollbar { display: none; }

  .product-page__thumb {
    width: 65px;
    height: 65px;
    border-radius: 6px;
    border: 2px solid transparent;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: var(--color-cream, #f5f0e8);
    flex-shrink: 0;
    transition: border-color 0.2s;
  }
  .product-page__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-page__thumb--active,
  .product-page__thumb:hover {
    border-color: var(--color-gold, #b8963e);
  }

  /* Main image */
  .product-page__main-img-wrap {
    position: relative;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-page__main-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .product-page__media-item {
    position: relative;
  }

  .product-page__wrapper {
    position: relative;
  }

  /* Zoom CSS commented out */

  .product-page__img-placeholder {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cream, #f5f0e8);
  }

  /* Cert logos overlay */
  .product-page__cert-logos {
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    z-index: 2;
    pointer-events: none;
  }

  .product-page__cert-logo {
    max-height: 52px;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .product-page__cert-logo { max-height: 36px; }
  }

  /* Image action icons */
  .product-page__img-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding-top: 8px;
  }

  .product-page__img-action-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    border: 1px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #444;
    transition: background 0.2s;
  }
  .product-page__img-action-btn:hover { background: #fff; }

  .product-page__compare-btn.is-active {
    border-color: var(--color-gold, #b8963e);
    box-shadow: 0 0 0 1px var(--color-gold, #b8963e);
  }

  .product-page__img-action-btn.is-wishlisted {
    border-color: var(--color-gold, #b8963e);
    background: #fff;
  }

  .product-page__img-action-btn.is-wishlisted svg {
    fill: var(--color-gold, #b8963e);
    stroke: var(--color-gold, #b8963e);
  }

  .product-page__gallery-buy-wrap {
    grid-column: 3 / 4;
    width: 100%;
    margin-top: 10px;
  }

  .product-page__gallery-buy-now {
    width: 100%;
    padding: 12px 16px;
    font-family: var(--font-accent, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: #000;
    border: 1px solid #000;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.1s;
  }

  .product-page__gallery-buy-now:hover {
    background: #b8963e;
    border-color: #b8963e;
  }

  .product-page__gallery-buy-now:active {
    transform: scale(0.97);
  }

  /* Info panel */
  .product-page__info {
    padding-top: 4px;
    padding-left: 32px;
    width: 100%;
  }

  .product-page__vendor {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold, #b8963e);
    margin-bottom: 6px;
  }

  .product-page__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
  }

  .product-page__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    margin: 0;
    color: var(--color-primary, #1a2a3a);
  }

  /* Badges */
  .product-page__badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .product-page__shipping-badge {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #555;
  }

  /* Meta row */
  .product-page__meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: #555;
    margin-bottom: 14px;
  }
  .product-page__meta-sep { color: #bbb; }
  .product-page__reviews-inline { display: flex; align-items: center; gap: 4px; }
  .product-page__stars { color: #f1c40f; letter-spacing: 1px; font-size: 13px; }

  /* Divider */
  .product-page__divider {
    height: 1px;
    background: var(--color-border-light, #eee);
    margin: 14px 0;
  }

  /* Price */
  .product-page__price-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .product-page__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .product-page__price-widget {
    display: flex;
    align-items: center;
  }

  .product-page__price {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-primary, #1a2a3a);
    font-family: var(--font-accent);
  }

  .product-page__compare-price {
    font-size: 15px;
    color: #aaa;
    text-decoration: line-through;
  }

  .product-page__price-note {
    font-size: 11px;
    color: #888;
  }


  /* Tabs */
  .product-page__tabs { margin-bottom: 18px; }

  .product-page__tab-nav {
    display: flex;
    border-bottom: 1px solid #e0e0e0;
    margin-bottom: 14px;
    gap: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .product-page__tab-nav::-webkit-scrollbar { display: none; }

  .product-page__tab-btn {
    flex: 0 0 auto;
    min-width: 155px;
    white-space: nowrap;
    padding: 10px 14px;
    font-size: 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 500;
    color: #777;
    background: none;
    border: 1px solid #e0e0e0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    margin-bottom: -1px;
    text-align: center;
  }
  .product-page__tab-btn:hover { color: #000; background: #f5f5f5; }
  .product-page__tab-btn--active {
    color: #000;
    border-bottom-color: #000;
    font-weight: 600;
  }

  .product-page__tab-pane {
    display: none;
    font-size: 13px;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: #555;
    line-height: 1.7;
    padding: 16px 0;
    position: relative;
  }
  .product-page__tab-pane--active { display: block; }

  /* FAQ tab */
  .product-page__faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 6px;
  }
  .product-page__faq-item {
    border-bottom: 1px solid #ececec;
    padding-bottom: 12px;
  }
  .product-page__faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .product-page__faq-q {
    font-weight: 600;
    color: var(--color-primary, #1a2a3a);
    margin: 0 0 6px;
    font-size: 13px;
  }
  .product-page__faq-a {
    margin: 0;
    color: #555;
    line-height: 1.55;
    font-size: 13px;
  }

  .product-page__tab-pane-inner {
    position: relative;
  }
  .product-page__tab-pane-inner:not(.is-expanded).has-overflow::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,1));
    pointer-events: none;
  }
  .product-page__tab-heading {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-primary, #1a2a3a);
    margin: 0 0 10px;
  }

  .product-page__tab-list {
    margin: 6px 0 0 16px;
    padding: 0;
    list-style: disc;
  }
  .product-page__tab-list li {
    margin-bottom: 3px;
    font-size: 13px;
  }

  .product-page__pa-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0 4px;
    font-size: 13px;
  }
  .product-page__pa-table th,
  .product-page__pa-table td {
    text-align: left;
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--color-border, #e5e0d8);
    vertical-align: top;
  }
  .product-page__pa-table th {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-weight: 600;
    color: var(--color-primary, #1a2a3a);
    white-space: nowrap;
  }
  .product-page__pa-table td em {
    font-style: italic;
  }

  .product-page__energisation-link {
    display: inline-block;
    margin-top: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary, #1a2a3a);
    text-decoration: underline;
  }

  .product-page__read-more {
    display: inline-block;
    margin-top: 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary, #1a2a3a);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .product-page__read-more:hover { color: var(--color-gold, #b8963e); }

  /* Customization panel */
  .product-page__customize-panel {
    background: var(--color-cream, #f5f0e8);
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  .product-page__customize-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .product-page__customize-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary, #1a2a3a);
    letter-spacing: 0.02em;
  }

  .product-page__reset-btn {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-gold, #b8963e);
    background: none;
    border: none;
    cursor: pointer;
    letter-spacing: 0.05em;
  }

  .product-page__customize-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .product-page__customize-cell {
    background: #fff;
    border-radius: 6px;
    padding: 8px 12px;
    border: 1px solid #e0e0e0;
  }
  .product-page__customize-cell--wide { grid-column: 1 / -1; }

  .product-page__customize-cell label {
    display: block;
    font-size: 10px;
    color: #888;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-page__customize-val {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-primary, #1a2a3a);
  }

  .product-page__metal-swatch {
    width: 20px;
    height: 14px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .product-page__metal-swatch--rose {
    background: linear-gradient(135deg, #e8c4a0, #c9956c);
  }

  .product-page__style-swatch {
    width: 20px;
    height: 20px;
    background: #f0f0f0;
    border-radius: 3px;
    border: 1px solid #ddd;
    flex-shrink: 0;
  }

  /* CTA buttons */
  .product-page__dual-cta {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  .product-page__dual-cta form {
    flex: 1;
  }

  .product-page__custom-cta {
    width: 100%;
    margin-bottom: 10px;
  }

  .product-page__custom-cta form {
    width: 100%;
  }

  /* Style the unbranded Shopify Buy It Now button to match the theme */
  .product-page__dual-cta .shopify-payment-button__button--unbranded,
  .product-page__custom-cta .shopify-payment-button__button--unbranded {
    background-color: #000000 !important;
    color: #ffffff !important;
    border-radius: 6px !important;
    font-size: 12px !important;
    font-family: var(--font-body, 'Inter', sans-serif) !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    padding: 14px 20px !important;
    line-height: normal !important;
    min-height: 48px !important;
    transition: all 0.2s !important;
  }
  .product-page__dual-cta .shopify-payment-button__button--unbranded:hover,
  .product-page__custom-cta .shopify-payment-button__button--unbranded:hover {
    background-color: #b8963e !important;
  }
  .product-page__dual-cta .shopify-payment-button__button--unbranded:active,
  .product-page__custom-cta .shopify-payment-button__button--unbranded:active {
    transform: scale(0.97) !important;
  }
  .product-page__dual-cta .shopify-payment-button__button--hidden,
  .product-page__custom-cta .shopify-payment-button__button--hidden {
    display: none !important;
  }

  .product-page__btn-outline {
    width: 100%;
    padding: 14px 20px;
    border: 1.5px solid #000;
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #fff;
    color: #000;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.1s;
  }
  .product-page__btn-outline:hover {
    background: #b8963e;
    color: #fff;
    border-color: #b8963e;
  }
  .product-page__btn-outline:active {
    transform: scale(0.97);
  }

  .product-page__btn-dark {
    flex: 1;
    width: 100%;
    padding: 14px 20px;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #000;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s, transform 0.1s;
  }
  .product-page__btn-dark:hover { background: #b8963e; }
  .product-page__btn-dark:active { transform: scale(0.97); }
  .product-page__btn-dark--full { margin-top: 0; }

  .product-page__btn-black {
    flex: 1;
    width: 100%;
    padding: 14px 20px;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #000;
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background 0.2s, transform 0.1s;
  }
  .product-page__btn-black:hover { background: #b8963e; }
  .product-page__btn-black:active { transform: scale(0.97); }

  /* Dispatch */
  .product-share {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-light, #eee);
  }
  .product-share--info { display: none; }
  .product-page__app-block--cert-mobile { display: none; }
  @media (max-width: 768px) {
    .product-share--gallery { display: none; }
    .product-share--info { display: block; }
    .product-page__app-block--gallery { display: none; }
    .product-page__app-block--cert-mobile { display: block; }
  }
  .product-share__label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888;
    margin-bottom: 10px;
  }
  .product-share__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .product-share__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
    transition: opacity 0.2s;
    font-family: var(--font-body);
  }
  .product-share__btn:hover { opacity: 0.8; }
  .product-share__btn--whatsapp { background: #25d366; color: #fff; }
  .product-share__btn--instagram { background: #e1306c; color: #fff; }
  .product-share__btn--email { background: #f5f0eb; color: #333; border-color: #ddd; }
  .product-share__btn--copy { background: #f5f0eb; color: #333; border-color: #ddd; }

  .product-page__dispatch {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: #555;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-light, #eee);
  }
  .product-page__dispatch strong { color: var(--color-primary, #1a2a3a); }
  .product-page__dispatch-sep { color: #bbb; }
  .product-page__pincode-link {
    color: var(--color-gold, #b8963e);
    text-decoration: none;
    font-weight: 500;
  }
  .product-page__pincode-link:hover { text-decoration: underline; }

  /* ====================== */
  /* You May Also Like       */
  /* ====================== */
  .product-recs {
    background: var(--color-bg, #faf8f4);
    padding: var(--space-3xl, 60px) 0 var(--space-4xl, 80px);
    position: relative;
  }

  .product-recs__title {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 32px;
    font-weight: 600;
    font-style: italic;
    text-align: center;
    color: var(--color-primary, #1a2a3a);
    margin-bottom: 8px;
  }

  .product-recs__header-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 24px;
  }

  .product-recs__view-all {
    font-size: 13px;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: var(--color-primary, #1a2a3a);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .product-recs__view-all:hover { color: var(--color-gold, #b8963e); }

  .product-recs__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) {
    .product-recs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .product-recs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }

  .product-recs__card-price {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary, #1a2a3a);
    margin: 0;
  }

  /* ======================== */
  /* Buying Process (PDP)     */
  /* ======================== */
  .pdp-buying-process {
    background: #d8c3ad;
    text-align: center;
    padding: var(--space-3xl, 60px) 0 var(--space-4xl, 80px);
  }

  .pdp-bp__heading {
    font-family: var(--font-heading, 'Cormorant Garamond', serif);
    font-size: 36px;
    font-weight: 400;
    font-style: italic;
    color: var(--color-primary, #1a2a3a);
    margin: 0 0 8px;
  }

  .pdp-bp__subheading {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    color: #555;
    margin: 0 0 var(--space-3xl, 48px);
  }

  .pdp-bp__grid {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md, 16px);
    flex-wrap: wrap;
  }

  .pdp-bp__item {
    flex: 1;
    min-width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pdp-bp__icon-wrap {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-lg, 20px);
    position: relative;
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
  }

  .pdp-bp__icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pdp-bp__icon svg,
  .pdp-bp__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-bp__number {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 24px;
    height: 24px;
    background: #2d4a3e;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-body, 'Inter', sans-serif);
    border: 2px solid #d8c3ad;
  }

  .pdp-bp__step-title {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 var(--space-sm, 8px);
    color: var(--color-primary, #1a2a3a);
  }

  .pdp-bp__step-desc {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    color: #555;
    line-height: 1.5;
    max-width: 200px;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .product-page__wrapper { grid-template-columns: 1fr; gap: var(--space-2xl, 40px); }
    .product-page__gallery, .product-page__info { padding-left: 0; padding-right: 0; }
  }

  @media (max-width: 768px) {

    /* 6. No horizontal scroll */
    .product-page__wrapper {
      overflow: hidden;
    }

    /* 1. Gallery — stack vertically, full width */
    .product-page__gallery {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
      padding: 0;
    }

    /* 1. Main image — consistent height, centered, aspect-ratio preserved */
    .product-page__main-img-wrap {
      order: 1;
      width: 100%;
      height: 420px;
      border-radius: 8px;
      padding: 12px;
      box-sizing: border-box;
    }

    .product-page__main-img-wrap .product-page__main-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border-radius: 4px;
    }

    /* Hide desktop action icons on mobile */
    .product-page__img-actions {
      display: none;
    }

    /* 2. Thumbnail strip — horizontal scroll, no clipping */
    .product-page__thumbstrip {
      order: 3;
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      max-height: none;
      padding: 4px 0 10px;
      justify-content: flex-start;
      gap: 8px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .product-page__thumbstrip::-webkit-scrollbar { display: none; }

    .product-page__gallery-buy-wrap {
      order: 2;
      grid-column: auto;
