<!-- You May Also Like -->
{%- assign recommendation_count = 0 -%}

{%- assign target_price = product.price -%}
{%- assign target_carats = product.metafields.custom.weight_carats | plus: 0.0 -%}
{%- assign current_gem_type = product.metafields.custom.gem_type | default: product.type -%}
{%- assign gem_collection_handle = current_gem_type | handleize -%}
{%- assign rec_collection = collections[gem_collection_handle] | default: collections.all -%}

{%- assign min_price = target_price | times: 0.90 -%}
{%- assign max_price = target_price | times: 1.10 -%}
{%- assign min_carat = target_carats | times: 0.90 -%}
{%- assign max_carat = target_carats | times: 1.10 -%}

{%- comment -%}
  Classify candidates into priority buckets so the suggestions are similar in
  weight, not just price:
    1. both  – close in price AND weight
    2. weight – close in weight only
    3. price – close in price only
  We then render the first 4 across those buckets in order.
{%- endcomment -%}
{%- assign both_handles = '' -%}
{%- assign weight_handles = '' -%}
{%- assign price_handles = '' -%}
{%- for p in rec_collection.products -%}
  {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
  {%- assign p_price = p.price -%}
  {%- assign p_carats = p.metafields.custom.weight_carats | plus: 0.0 -%}

  {%- assign price_match = false -%}
  {%- assign carat_match = false -%}
  {%- if p_price >= min_price and p_price <= max_price -%}
    {%- assign price_match = true -%}
  {%- endif -%}
  {%- if target_carats > 0 and p_carats >= min_carat and p_carats <= max_carat -%}
    {%- assign carat_match = true -%}
  {%- endif -%}

  {%- if price_match and carat_match -%}
    {%- assign both_handles = both_handles | append: p.handle | append: ' ' -%}
  {%- elsif carat_match -%}
    {%- assign weight_handles = weight_handles | append: p.handle | append: ' ' -%}
  {%- elsif price_match -%}
    {%- assign price_handles = price_handles | append: p.handle | append: ' ' -%}
  {%- endif -%}
{%- endfor -%}

{%- assign ordered_handles = both_handles | append: weight_handles | append: price_handles | split: ' ' -%}
{%- capture rec_cards -%}
  {%- for h in ordered_handles -%}
    {%- assign rp = all_products[h] -%}
    {%- if rp != blank and rp.id -%}
      {% render 'product-card', product: rp %}
      {%- assign recommendation_count = recommendation_count | plus: 1 -%}
      {%- if recommendation_count >= 4 -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if recommendation_count > 0 -%}
<section class="product-recs" id="product-recs">
  <div class="page-width">
    <h2 class="product-recs__title">You May Also Like</h2>
    <div class="product-recs__header-row">
      <span></span>
      <a href="/collections/{{ gem_collection_handle | default: 'all' }}" class="product-recs__view-all">View All &rarr;</a>
    </div>
    <div class="product-recs__grid" id="product-recs-grid">
      {{ rec_cards }}
    </div>
  </div>
</section>
<script>
  (function() {
    var grid = document.getElementById('product-recs-grid');
    if (!grid) return;
    var cards = Array.from(grid.children);
    for (var i = cards.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(cards[j]);
      cards.splice(j, 1);
    }
  })();
</script>
{%- endif -%}

