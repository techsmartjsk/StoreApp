                    {%- assign faq_treatment_answer = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
                  {%- when 'Minor oil' -%}
                    {%- assign faq_treatment_answer = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
                  {%- when 'Moderate oil' -%}
                    {%- assign faq_treatment_answer = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
                  {%- when 'Colourless Oiling Only' -%}
                    {%- assign faq_treatment_answer = 'This gem is considered astrologically suitable. Oiling of emeralds is a common trade practice.' -%}
                  {%- when 'Minor natural Resin' -%}
