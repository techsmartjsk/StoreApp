  function getDesignFiles(metal, gem, did) {
    return PENDANT_DESIGN_FILES[metal + '|' + gem + '|' + did] || [];
  }

  function assetBase() {
    return document.getElementById('PendantCustomizer').dataset.assetBase || '';
  }

  // ── Render pendant grid
  function renderGrid() {
    const grid   = document.getElementById('PcRingsGrid');
    const empty  = document.getElementById('PcEmpty');
    grid.innerHTML = '';

    const { metal, gem } = state;
    const gemMap  = PENDANT_MAP[gem];
    const ids     = (gemMap && gemMap[metal]) || [];

    if (ids.length === 0) {
      empty.style.display = '';
      return;
    }
    empty.style.display = 'none';

    ids.forEach(function(did) {
      const files = getDesignFiles(metal, gem, did);
      if (!files.length) return;

      const card = document.createElement('div');
      card.className = 'pc-ring-card';
      card.setAttribute('data-ring-id', did);
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');

      // Build carousel slides
      const slides = files.map(function(fname, i) {
        return '<div class="pc-card-carousel__slide">' +
          '<img src="' + assetBase() + fname + '" alt="Design ' + did + ' view ' + (i+1) + '" loading="lazy">' +
        '</div>';
      }).join('');

      // Dots
      const dots = files.length > 1 ? files.map(function(_, i) {
        return '<button class="pc-card-dot' + (i === 0 ? ' is-active' : '') + '" data-idx="' + i + '" aria-label="Image ' + (i+1) + '"></button>';
      }).join('') : '';

      const prevBtn = files.length > 1
        ? '<button class="pc-card-carousel__btn pc-card-carousel__btn--prev" aria-label="Previous"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>'
        : '';
      const nextBtn = files.length > 1
        ? '<button class="pc-card-carousel__btn pc-card-carousel__btn--next" aria-label="Next"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>'
        : '';

      card.innerHTML =
        '<div class="pc-card-carousel">' +
          '<div class="pc-card-carousel__track">' + slides + '</div>' +
          prevBtn + nextBtn +
          (dots ? '<div class="pc-card-carousel__dots">' + dots + '</div>' : '') +
        '</div>' +
        '<div class="pc-ring-card__label">Design ' + did + '</div>';

      // Carousel logic
      if (files.length > 1) {
        var cur = 0;
        var track = card.querySelector('.pc-card-carousel__track');
        var dotEls = card.querySelectorAll('.pc-card-dot');

        function goTo(idx) {
          cur = (idx + files.length) % files.length;
          track.style.transform = 'translateX(-' + (cur * 100) + '%)';
          dotEls.forEach(function(d, i) {
            d.classList.toggle('is-active', i === cur);
          });
        }

        card.querySelector('.pc-card-carousel__btn--prev').addEventListener('click', function(e) {
          e.stopPropagation();
          goTo(cur - 1);
        });
        card.querySelector('.pc-card-carousel__btn--next').addEventListener('click', function(e) {
          e.stopPropagation();
          goTo(cur + 1);
        });
        dotEls.forEach(function(d) {
          d.addEventListener('click', function(e) {
            e.stopPropagation();
            goTo(parseInt(d.dataset.idx));
          });
        });
      }

      card.addEventListener('click', function() { openLightbox(did); });
      card.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') openLightbox(did); });
      grid.appendChild(card);
    });
  }

  // ── Lightbox
  function openLightbox(did) {
    const { metal, gem } = state;
    const files = getDesignFiles(metal, gem, did);
    const lb      = document.getElementById('PcLightbox');
    const mainImg = document.getElementById('PcLightboxMain');
    const thumbsEl = document.getElementById('PcLightboxThumbs');
    const metaEl   = document.getElementById('PcLightboxMeta');

    thumbsEl.innerHTML = '';

    files.forEach(function(fname, i) {
      const url = assetBase() + fname;
      if (i === 0) mainImg.src = url;

      const thumb = document.createElement('div');
      thumb.className = 'pc-thumb' + (i === 0 ? ' is-active' : '');
      thumb.innerHTML = '<img src="' + url + '" alt="View ' + (i+1) + '" loading="lazy">';
      thumb.addEventListener('click', function() {
        mainImg.src = url;
        thumbsEl.querySelectorAll('.pc-thumb').forEach(function(t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
      thumbsEl.appendChild(thumb);
    });

    metaEl.textContent = GEM_LABELS[gem] + ' · ' + METAL_LABELS[metal] + ' · Design ' + did;

    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    document.querySelectorAll('.pc-ring-card').forEach(function(c) {
      c.classList.toggle('is-selected', c.dataset.ringId === did);
    });
  }

  function closeLightbox() {
    document.getElementById('PcLightbox').style.display = 'none';
    document.body.style.overflow = '';
    document.querySelectorAll('.pc-ring-card').forEach(function(c) { c.classList.remove('is-selected'); });
  }

  // ── Wire up controls
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('PendantCustomizer');

    // Set Shopify asset base URL
    container.dataset.assetBase = '{{ "pendant_copper_blue-sapphire_CO01.jpg" | asset_url }}'.replace('pendant_copper_blue-sapphire_CO01.jpg', '');

    // Metal
    container.querySelectorAll('.pc-metal-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        container.querySelectorAll('.pc-metal-btn').forEach(function(b) {
          b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');
        state.metal = btn.dataset.metal;
        renderGrid();
      });
    });

    // Gem
    container.querySelectorAll('.pc-gem-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        container.querySelectorAll('.pc-gem-btn').forEach(function(b) {
          b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');
        state.gem = btn.dataset.gem;
        renderGrid();
      });
    });

    // Lightbox close
    document.getElementById('PcLightboxClose').addEventListener('click', closeLightbox);
    document.getElementById('PcLightboxBackdrop').addEventListener('click', closeLightbox);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });

    renderGrid();
  });
})();
</script>

