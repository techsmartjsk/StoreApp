<section class="pendant-customizer section-padding" id="pendant-customizer-{{ section.id }}">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading pendant-customizer__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="pendant-customizer__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="pendant-customizer__ui" id="PendantCustomizer">

      <!-- Step 1: Metal -->
      <div class="pc-step">
        <p class="pc-step__label">Select metal</p>
        <div class="pc-metal-grid">
          {%- assign metals = 'copper,gold,panchdhatu,platinum,silver,white-gold' | split: ',' -%}
          {%- assign metal_labels = 'Copper,Gold,Panchdhatu,Platinum,Silver,White Gold' | split: ',' -%}
          {%- for metal in metals -%}
            <button
              class="pc-metal-btn{% if forloop.index == 2 %} is-active{% endif %}"
              data-metal="{{ metal }}"
              aria-pressed="{% if forloop.index == 2 %}true{% else %}false{% endif %}"
            >
              <span class="pc-metal-swatch pc-metal-swatch--{{ metal }}"></span>
              {{ metal_labels[forloop.index0] }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Step 2: Gem -->
      <div class="pc-step">
        <p class="pc-step__label">Gemstone</p>
        <div class="pc-gem-grid">
          {%- assign gems = 'aquamarine,amethyst,blue-sapphire,blue-topaz,cats-eye,citrine,emerald,garnet,hessonite,iolite,lapis-lazuli,malachite,moonstone,natural-zircon,navratna,opal,padparadscha,peach-sapphire,pearl,peridot,pitambari,purple-sapphire,red-coral,ruby,sphatik,star-sapphire,tiger-eye,tourmaline,turquoise,white-coral,white-sapphire,yellow-sapphire' | split: ',' -%}
          {%- assign gem_labels = 'Aquamarine,Amethyst,Blue Sapphire,Blue Topaz,Cats Eye,Citrine,Emerald,Garnet,Hessonite,Iolite,Lapis Lazuli,Malachite,Moonstone,Natural Zircon,Navratna,Opal,Padparadscha,Peach Sapphire,Pearl,Peridot,Bi-colour Sapphire,Purple Sapphire,Red Coral,Ruby,Sphatik,Star Sapphire,Tiger Eye,Tourmaline,Turquoise,White Coral,White Sapphire,Yellow Sapphire' | split: ',' -%}
          {%- assign default_gem = section.settings.default_gem | default: 'blue-sapphire' -%}
          {%- for gem in gems -%}
            <button
              class="pc-gem-btn{% if gem == default_gem %} is-active{% endif %}"
              data-gem="{{ gem }}"
              aria-pressed="{% if gem == default_gem %}true{% else %}false{% endif %}"
            >
              {{ gem_labels[forloop.index0] }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <!-- Step 3: Pendant designs grid -->
      <div class="pc-step pc-step--rings">
        <p class="pc-step__label">Select design</p>
        <div class="pc-rings-grid" id="PcRingsGrid">
          <!-- Populated by JS -->
        </div>
        <p class="pc-empty" id="PcEmpty" style="display:none;">No pendant designs available for this combination.</p>
      </div>

      <!-- Lightbox / expanded view -->
      <div class="pc-lightbox" id="PcLightbox" style="display:none;" role="dialog" aria-modal="true" aria-label="Pendant detail">
        <div class="pc-lightbox__backdrop" id="PcLightboxBackdrop"></div>
        <div class="pc-lightbox__panel">
          <button class="pc-lightbox__close" id="PcLightboxClose" aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
          <div class="pc-lightbox__main-img-wrap">
            <img id="PcLightboxMain" class="pc-lightbox__main-img" src="" alt="Pendant view">
          </div>
          <div class="pc-lightbox__thumbs" id="PcLightboxThumbs"></div>
          <div class="pc-lightbox__meta" id="PcLightboxMeta"></div>
        </div>
      </div>

    </div><!-- /pendant-customizer__ui -->
  </div>
</section>

<style>
  .pendant-customizer {
    background: var(--color-cream-light, #faf7f3);
  }
  .pendant-customizer__heading {
    text-align: left;
    margin-bottom: 8px;
  }
  .pendant-customizer__subheading {
    text-align: left;
    color: var(--color-text-muted, #888);
    font-size: 14px;
    margin-bottom: var(--space-2xl);
  }

  /* Steps */
  .pc-step {
    margin-bottom: var(--space-2xl, 32px);
  }
  .pc-step__label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #888;
    margin: 0 0 12px;
  }

  /* Gender toggle */
  .pc-gender-toggle {
    display: inline-flex;
    border: 1px solid #e0d8cc;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }
  .pc-gender-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: #888;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.03em;
  }
  .pc-gender-btn + .pc-gender-btn {
    border-left: 1px solid #e0d8cc;
  }
  .pc-gender-btn.is-active {
    background: var(--color-primary, #1a2a3a);
    color: #fff;
  }
  .pc-gender-btn:not(.is-active):hover {
    background: #f5f0e8;
    color: var(--color-primary, #1a2a3a);
  }

  /* Metal grid */
  .pc-metal-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pc-metal-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border: 1.5px solid #e0d8cc;
    border-radius: 6px;
    background: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: #555;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.03em;
  }
  .pc-metal-btn:hover {
    border-color: var(--color-gold, #c9a96e);
    color: var(--color-primary, #1a2a3a);
  }
  .pc-metal-btn.is-active {
    border-color: var(--color-gold, #c9a96e);
    background: #fff8ee;
    color: var(--color-primary, #1a2a3a);
    box-shadow: 0 0 0 1px var(--color-gold, #c9a96e);
  }

  /* Metal swatches */
  .pc-metal-swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.12);
    flex-shrink: 0;
  }
  .pc-metal-swatch--copper { background: radial-gradient(circle at 35% 35%, #e8a87c, #b5651d); }
  .pc-metal-swatch--gold { background: radial-gradient(circle at 35% 35%, #fde68a, #c9a96e); }
  .pc-metal-swatch--panchdhatu { background: radial-gradient(circle at 35% 35%, #d4c5a9, #8b7355); }
  .pc-metal-swatch--platinum { background: radial-gradient(circle at 35% 35%, #f0f0f0, #9ca3af); }
  .pc-metal-swatch--silver { background: radial-gradient(circle at 35% 35%, #f8f8f8, #a8a8a8); }
  .pc-metal-swatch--white-gold { background: radial-gradient(circle at 35% 35%, #ffffff, #c8c8c8); }

  /* Gem selector */
  .pc-gem-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pc-gem-btn {
    padding: 8px 18px;
    border: 1.5px solid #e0d8cc;
    border-radius: 20px;
    background: #fff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: #555;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pc-gem-btn:hover {
    border-color: var(--color-gold, #c9a96e);
    color: var(--color-primary, #1a2a3a);
  }
  .pc-gem-btn.is-active {
    background: var(--color-gold, #c9a96e);
    border-color: var(--color-gold, #c9a96e);
    color: #fff;
  }

  /* Rings grid */
  .pc-step--rings { margin-top: var(--space-xl); }
  .pc-rings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }

  /* Ring card with carousel */
  .pc-ring-card {
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    position: relative;
  }
  .pc-ring-card:hover {
    border-color: var(--color-gold, #c9a96e);
    box-shadow: 0 4px 16px rgba(201,169,110,0.2);
    transform: translateY(-2px);
  }
  .pc-ring-card.is-selected {
    border-color: var(--color-gold, #c9a96e);
    box-shadow: 0 0 0 3px rgba(201,169,110,0.3);
  }

  /* Carousel inside each card */
  .pc-card-carousel {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f8f5f0;
  }
  .pc-card-carousel__track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.35s ease;
  }
  .pc-card-carousel__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }
  .pc-card-carousel__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pc-card-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    background: rgba(255,255,255,0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    transition: background 0.15s;
    padding: 0;
  }
  .pc-card-carousel__btn svg { pointer-events: none; }
  .pc-card-carousel__btn:hover { background: #fff; }
  .pc-card-carousel__btn--prev { left: 4px; }
  .pc-card-carousel__btn--next { right: 4px; }
  .pc-ring-card:hover .pc-card-carousel__btn { display: flex; }
  .pc-card-carousel__dots {
    position: absolute;
    bottom: 5px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 4px;
    z-index: 2;
  }
  .pc-card-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    transition: background 0.15s;
    cursor: pointer;
    border: none;
    padding: 0;
  }
  .pc-card-dot.is-active { background: #fff; }

  .pc-ring-card__label {
    padding: 8px 10px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: #555;
    text-align: left;
    letter-spacing: 0.05em;
  }

  .pc-empty {
    font-family: var(--font-body);
    font-size: 13px;
    color: #999;
    font-style: italic;
    padding: 20px 0;
  }

  /* Lightbox */
  .pc-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .pc-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
  }
  .pc-lightbox__panel {
    position: relative;
    z-index: 1;
    background: #fff;
    border-radius: 12px;
    padding: 32px;
    max-width: 540px;
    width: 100%;
    box-shadow: 0 24px 60px rgba(0,0,0,0.25);
  }
  .pc-lightbox__close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f0e8;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: #555;
    transition: all 0.2s;
  }
  .pc-lightbox__close:hover { background: #e9e9ed; color: #000; }
  .pc-lightbox__main-img-wrap {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: #f8f5f0;
    margin-bottom: 16px;
  }
  .pc-lightbox__main-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pc-lightbox__thumbs {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-bottom: 16px;
  }
  .pc-thumb {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.15s;
    background: #f5f0e8;
  }
  .pc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pc-thumb.is-active { border-color: var(--color-gold, #c9a96e); }
  .pc-thumb:hover { border-color: #c9a96e88; }
  .pc-lightbox__meta {
    text-align: left;
    font-family: var(--font-body);
    font-size: 12px;
    color: #888;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .pc-rings-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .pc-lightbox__panel { padding: 20px; }
    .pc-metal-grid { gap: 8px; }
    .pc-metal-btn { padding: 8px 12px; font-size: 11px; }
  }
</style>

