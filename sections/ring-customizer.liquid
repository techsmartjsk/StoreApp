p","ring_whitegold_female_ruby_WGFL26_T.webp","ring_whitegold_female_ruby_WGFL26_B.webp"]};

  const METAL_LABELS = {
    'copper': 'Copper', 'gold': 'Gold', 'panchdhatu': 'Panchdhatu',
    'platinum': 'Platinum', 'silver': 'Silver', 'white-gold': 'White Gold'
  };
  const GEM_LABELS = {
    'blue-sapphire': 'Blue Sapphire', 'emerald': 'Emerald', 'opal': 'Opal',
    'ruby': 'Ruby', 'yellow-sapphire': 'Yellow Sapphire'
  };

  let state = { gender: 'female', metal: 'gold', gem: '{{ section.settings.default_gem | default: "blue-sapphire" }}' };

  function getDesignFiles(metal, gender, gem, did) {
    return DESIGN_FILES[metal + '|' + gender + '|' + gem + '|' + did] || [];
  }

  function assetBase() {
    return document.getElementById('RingCustomizer').dataset.assetBase || '';
  }

  // ── Render ring grid
  function renderGrid() {
    const grid   = document.getElementById('RcRingsGrid');
    const empty  = document.getElementById('RcEmpty');
    grid.innerHTML = '';

    const { gender, metal, gem } = state;
    const gemMap  = RING_MAP[gender] && RING_MAP[gender][gem];
    const ids     = (gemMap && gemMap[metal]) || [];

    if (ids.length === 0) {
      empty.style.display = '';
      return;
    }
    empty.style.display = 'none';

    ids.forEach(function(did) {
      const files = getDesignFiles(metal, gender, gem, did);
      if (!files.length) return;

      const card = document.createElement('div');
      card.className = 'rc-ring-card';
      card.setAttribute('data-ring-id', did);
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');

      // Build carousel slides
      const slides = files.map(function(fname, i) {
        return '<div class="rc-card-carousel__slide">' +
          '<img src="' + assetBase() + fname + '" alt="Design ' + did + ' view ' + (i+1) + '" loading="lazy">' +
        '</div>';
      }).join('');

      // Dots
      const dots = files.length > 1 ? files.map(function(_, i) {
        return '<button class="rc-card-dot' + (i === 0 ? ' is-active' : '') + '" data-idx="' + i + '" aria-label="Image ' + (i+1) + '"></button>';
      }).join('') : '';

      const prevBtn = files.length > 1
        ? '<button class="rc-card-carousel__btn rc-card-carousel__btn--prev" aria-label="Previous"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg></button>'
        : '';
      const nextBtn = files.length > 1
        ? '<button class="rc-card-carousel__btn rc-card-carousel__btn--next" aria-label="Next"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg></button>'
        : '';

      card.innerHTML =
        '<div class="rc-card-carousel">' +
          '<div class="rc-card-carousel__track">' + slides + '</div>' +
          prevBtn + nextBtn +
          (dots ? '<div class="rc-card-carousel__dots">' + dots + '</div>' : '') +
        '</div>' +
        '<div class="rc-ring-card__label">Design ' + did + '</div>';

      // Carousel logic
      if (files.length > 1) {
        var cur = 0;
        var track = card.querySelector('.rc-card-carousel__track');
        var dotEls = card.querySelectorAll('.rc-card-dot');

        function goTo(idx) {
          cur = (idx + files.length) % files.length;
          track.style.transform = 'translateX(-' + (cur * 100) + '%)';
          dotEls.forEach(function(d, i) {
            d.classList.toggle('is-active', i === cur);
          });
        }

        card.querySelector('.rc-card-carousel__btn--prev').addEventListener('click', function(e) {
          e.stopPropagation();
          goTo(cur - 1);
        });
        card.querySelector('.rc-card-carousel__btn--next').addEventListener('click', function(e) {
          e.stopPropagation();
          goTo(cur + 1);
        });
        dotEls.forEach(function(d) {
          d.addEventListener('click', function(e) {
            e.stopPropagation();
            goTo(parseInt(d.dataset.idx));
          });
        });
      }

      card.addEventListener('click', function() { openLightbox(did); });
      card.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') openLightbox(did); });
      grid.appendChild(card);
    });
  }

  // ── Lightbox
  function openLightbox(did) {
    const { gender, metal, gem } = state;
    const files = getDesignFiles(metal, gender, gem, did);
    const lb      = document.getElementById('RcLightbox');
    const mainImg = document.getElementById('RcLightboxMain');
    const thumbsEl = document.getElementById('RcLightboxThumbs');
    const metaEl   = document.getElementById('RcLightboxMeta');

    thumbsEl.innerHTML = '';

    files.forEach(function(fname, i) {
      const url = assetBase() + fname;
      if (i === 0) mainImg.src = url;

      const thumb = document.createElement('div');
      thumb.className = 'rc-thumb' + (i === 0 ? ' is-active' : '');
      thumb.innerHTML = '<img src="' + url + '" alt="View ' + (i+1) + '" loading="lazy">';
      thumb.addEventListener('click', function() {
        mainImg.src = url;
        thumbsEl.querySelectorAll('.rc-thumb').forEach(function(t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
      thumbsEl.appendChild(thumb);
    });

    metaEl.textContent = GEM_LABELS[gem] + ' · ' + METAL_LABELS[metal] + ' · ' + (gender === 'female' ? 'Female' : 'Male') + ' · Design ' + did;

    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    document.querySelectorAll('.rc-ring-card').forEach(function(c) {
      c.classList.toggle('is-selected', c.dataset.ringId === did);
    });
  }

  function closeLightbox() {
    document.getElementById('RcLightbox').style.display = 'none';
    document.body.style.overflow = '';
    document.querySelectorAll('.rc-ring-card').forEach(function(c) { c.classList.remove('is-selected'); });
  }

  // ── Wire up controls
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('RingCustomizer');

    // Set Shopify asset base URL
    container.dataset.assetBase = '{{ "ring_copper_female_blue-sapphire_D1_1.jpeg" | asset_url }}'.replace('ring_copper_female_blue-sapphire_D1_1.jpeg', '');

    // Gender
    container.querySelectorAll('.rc-gender-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        container.querySelectorAll('.rc-gender-btn').forEach(function(b) {
          b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');
        state.gender = btn.dataset.gender;
        renderGrid();
      });
    });

    // Metal
    container.querySelectorAll('.rc-metal-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        container.querySelectorAll('.rc-metal-btn').forEach(function(b) {
          b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');
        state.metal = btn.dataset.metal;
        renderGrid();
      });
    });

    // Gem
    container.querySelectorAll('.rc-gem-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        container.querySelectorAll('.rc-gem-btn').forEach(function(b) {
          b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active'); btn.setAttribute('aria-pressed', 'true');
        state.gem = btn.dataset.gem;
        renderGrid();
      });
    });

    // Lightbox close
    document.getElementById('RcLightboxClose').addEventListener('click', closeLightbox);
    document.getElementById('RcLightboxBackdrop').addEventListener('click', closeLightbox);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });

    renderGrid();
  });
})();
</script>

{% schema %}
{
  "name": "Ring Customizer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Perfect Ring"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose your gender, metal, and gemstone to explore matching ring designs."
    },
    {
      "type": "select",
      "id": "default_gem",
      "label": "Default gemstone",
      "options": [
        { "value": "blue-sapphire",   "label": "Blue Sapphire" },
        { "value": "emerald",         "label": "Emerald" },
        { "value": "opal",            "label": "Opal" },
        { "value": "ruby",            "label": "Ruby" },
        { "value": "yellow-sapphire", "label": "Yellow Sapphire" }
      ],
      "default": "blue-sapphire"
    }
  ],
  "presets": [
    {
      "name": "Ring Customizer"
    }
  ]
}
{% endschema %}
