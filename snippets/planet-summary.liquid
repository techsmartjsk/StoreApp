{%- comment -%}
  Planet hero summary — shown beside the hero image on planet collection pages
  (surya, chandra, mangal, budh, guru, shukra, shani, rahu, ketu).
  Usage: {%- render 'planet-summary', planet_handle: collection.handle -%}
{%- endcomment -%}

<div class="planet-summary planet-summary--{{ planet_handle }}">
  {%- case planet_handle -%}
    {%- when 'surya' -%}
      <h1 class="planet-summary__title">☀️ SURYA (Sun)</h1>
      <p class="planet-summary__qualities">Vitality · Authority · Self-Worth</p>
      <div class="planet-summary__text">
        <p>The center of life force and identity, Surya governs confidence, leadership, purpose, and personal power. A balanced Sun brings clarity, courage, vitality, and inner authority without ego.</p>
      </div>
      <p class="planet-summary__represents"><strong>Represents:</strong> Authority, confidence, vitality, self-esteem, leadership, purpose</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Ruby (Manik)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Red Spinel • 🔶 Garnet</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ ह्रां ह्रीं ह्रौं सः सूर्याय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Hraam Hreem Hraum Sah Suryaya Namah</p>
      </div>

    {%- when 'chandra' -%}
      <h1 class="planet-summary__title">🌙 CHANDRA (Moon)</h1>
      <p class="planet-summary__qualities">Mind · Emotion · Inner Balance · Peace</p>
      <div class="planet-summary__text">
        <p>The keeper of emotions and inner peace, Chandra governs the mind, intuition, memory, comfort, and emotional well-being.</p>
      </div>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Pearl (Moti)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Moonstone</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ श्रां श्रीं श्रौं सः चन्द्राय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Shraam Shreem Shraum Sah Chandraya Namah</p>
      </div>

    {%- when 'mangal' -%}
      <h1 class="planet-summary__title">♂ MANGAL (Mars)</h1>
      <p class="planet-summary__qualities">Energy · Courage · Disciplined Action</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Red Coral (Moonga)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 White Coral</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ क्रां क्रीं क्रौं सः भौमाय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Kraam Kreem Kraum Sah Bhaumaya Namah</p>
      </div>

    {%- when 'budh' -%}
      <h1 class="planet-summary__title">☿ BUDH (Mercury)</h1>
      <p class="planet-summary__qualities">Intellect · Communication · Clarity</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Emerald (Panna)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Peridot • 🔶 Green Tourmaline</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ ब्रां ब्रीं ब्रौं सः बुधाय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Braam Breem Braum Sah Budhaya Namah</p>
      </div>

    {%- when 'guru' -%}
      <h1 class="planet-summary__title">♃ GURU (Jupiter)</h1>
      <p class="planet-summary__qualities">Wisdom · Growth · Prosperity</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Yellow Sapphire (Pukhraj)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Citrine • 🔶 Yellow Topaz</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ ग्रां ग्रीं ग्रौं सः गुरवे नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Graam Greem Graum Sah Gurave Namah</p>
      </div>

    {%- when 'shukra' -%}
      <h1 class="planet-summary__title">♀ SHUKRA (Venus)</h1>
      <p class="planet-summary__qualities">Harmony · Beauty · Relationships</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 White Sapphire</p>
      <p class="planet-summary__gem"><strong>Accepted Alternatives &amp; Upratna:</strong> 🔶 Opal • 🔶 Zircon</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ द्रां द्रीं द्रौं सः शुक्राय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Draam Dreem Draum Sah Shukraya Namah</p>
      </div>

    {%- when 'shani' -%}
      <h1 class="planet-summary__title">♄ SHANI (Saturn)</h1>
      <p class="planet-summary__qualities">Discipline · Stability · Endurance</p>
      <div class="planet-summary__text">
        <p>The master of karma and responsibility, Shani rewards patience, truth, and consistent effort.</p>
      </div>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Blue Sapphire (Neelam)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Iolite (Neeli) • 🔶 Amethyst</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ प्रां प्रीं प्रौं सः शनैश्चराय नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Praam Preem Praum Sah Shanaishcharaya Namah</p>
      </div>

    {%- when 'rahu' -%}
      <h1 class="planet-summary__title">☊ RAHU</h1>
      <p class="planet-summary__qualities">Ambition · Innovation · Discernment</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Hessonite (Gomed)</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ भ्रां भ्रीं भ्रौं सः राहवे नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Bhraam Bhreem Bhraum Sah Rahave Namah</p>
      </div>

    {%- when 'ketu' -%}
      <h1 class="planet-summary__title">☋ KETU</h1>
      <p class="planet-summary__qualities">Detachment · Insight · Spiritual Clarity</p>
      <p class="planet-summary__gem"><strong>Navratna:</strong> 💎 Cat's Eye (Chrysoberyl)</p>
      <p class="planet-summary__gem"><strong>Accepted Upratna:</strong> 🔶 Quartz Cat's Eye</p>
      <div class="planet-summary__mantra">
        <p class="planet-summary__mantra-label"><strong>Beej Mantra:</strong></p>
        <p class="planet-summary__mantra-sanskrit">🕉️ ॐ स्रां स्रीं स्रौं सः केतवे नमः ।</p>
        <p class="planet-summary__mantra-translit">Om Straam Streem Straum Sah Ketave Namah</p>
      </div>
  {%- endcase -%}
</div>

<style>
  .planet-summary {
    font-family: var(--font-body, 'Inter', sans-serif);
    color: #1a1a1a;
  }
  .planet-summary__title {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 18px;
    letter-spacing: 0.01em;
  }
  .planet-summary__qualities {
    font-weight: 700;
    font-size: 15px;
    margin: 0 0 22px;
    letter-spacing: 0.01em;
  }
  .planet-summary__text {
    margin: 0 0 22px;
  }
  .planet-summary__text p {
    margin: 0 0 6px;
    font-size: 16px;
    line-height: 1.6;
    color: #2a2a2a;
  }
  .planet-summary__represents {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: #2a2a2a;
  }
  .planet-summary__gem {
    font-size: 16px;
    line-height: 1.6;
    margin: 0 0 14px;
  }
  .planet-summary__mantra {
    margin: 20px 0 0;
  }
  .planet-summary__mantra-label {
    font-size: 16px;
    margin: 0 0 4px;
  }
  .planet-summary__mantra-sanskrit {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 4px;
  }
  .planet-summary__mantra-translit {
    font-style: italic;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
  }
  .planet-summary__note {
    font-style: italic;
    font-size: 14px;
    color: #555;
    line-height: 1.55;
    margin: 18px 0 0;
  }
  @media (max-width: 768px) {
    .planet-summary__title { font-size: 26px; }
  }
</style>
