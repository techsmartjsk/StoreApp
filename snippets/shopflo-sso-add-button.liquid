<!-- Shopflo Script to Add Shopflo Button in the Header [Starts] -->
<script>
  // ------------------------
  // Loader SVG for buttons
  // ------------------------
  const loader = `<svg class="loader flo-loader" width="800" height="800" viewBox="0 0 32 32"><title>loader</title><path d="M16 .75c-.69 0-1.25.56-1.25 1.25v8a1.25 1.25 0 0 0 2.5 0V2c0-.69-.56-1.25-1.25-1.25m0 20c-.69 0-1.25.56-1.25 1.25v8a1.25 1.25 0 0 0 2.5 0v-8c0-.69-.56-1.25-1.25-1.25M11.25 16c0-.69-.56-1.25-1.25-1.25H2a1.25 1.25 0 0 0 0 2.5h8c.69 0 1.25-.56 1.25-1.25M30 14.75h-8a1.25 1.25 0 0 0 0 2.5h8a1.25 1.25 0 0 0 0-2.5M6.984 5.217a1.25 1.25 0 0 0-1.768 1.768l5.657 5.657a1.25 1.25 0 0 0 1.768-1.768zm14.143 14.14a1.25 1.25 0 0 0-1.769 1.769l5.658 5.658a1.25 1.25 0 1 0 1.77-1.769zm-10.253 0-5.657 5.658a1.25 1.25 0 1 0 1.768 1.77l5.657-5.658a1.25 1.25 0 1 0-1.768-1.77m9.368-6.349h.002c.345 0 .657-.14.883-.366l5.658-5.657a1.25 1.25 0 1 0-1.77-1.768l-5.658 5.657a1.25 1.25 0 0 0 .884 2.134z"/></svg>`;

  // ------------------------
  // Append CSS styles to <head>
  // ------------------------
  function appendCss() {
    let css = `
      .loader { display: block; animation: rotate 1.5s linear infinite; }
      .loader-container { display: flex; justify-content: center; align-items: center; width: 100%; height: 100%; }
      .loader-container > .loader { height: 16px !important; width: 16px !important; }

      @keyframes rotate {
        100% { transform: rotate(360deg); }
      }

      .flo-disabled-text-color { cursor: not-allowed; }

      .flo-full-width {width: 100%;}

      #logout-button-desktop, #logout-button-mobile, #account-button-desktop {
        cursor: pointer;
        font: inherit;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #344054;
        font-style: normal;
        font-weight: 500;
        line-height: 20px;
        width: 100%;
        border-radius: 8px;
        padding: 8px 14px;
        border: none;
        background: var(--base-white, #fff);
      }

      #logout-button-desktop > p, #logout-button-mobile > p { margin: 0; padding: 0; }

      #loggedin-icons, #loggedin-icons-mobile { display: none; align-self: center; }

      #shopflo-drawer-desktop, #shopflo-drawer-mobile {
        padding: 4px;
        display: none;
        right: 0%;
        position: absolute;
        width: 9rem;
        top: 100%;
        box-shadow: 0px 1px 4px 0px #00000040;
        border-radius: 8px;
        z-index: 9999;
        background: #fff !important;
      }

      #shopflo-drawer-desktop > ul, #shopflo-drawer-mobile > ul {
        margin: 0;
        padding: 0;
        width: 100%;
      }

      #shopflo-drawer-desktop > ul > a, #shopflo-drawer-mobile > ul > a {
        cursor: pointer;
        display: flex !important;
        align-items: baseline;
        height: 38px;
        padding: 0;
        color: inherit;
        margin-left: 0 !important;
        text-decoration: none;
      }

      #shopflo-drawer-desktop > ul > a:hover,
      #shopflo-drawer-mobile > ul > a:hover,
      #shopflo-drawer-desktop > ul > a:focus,
      #shopflo-drawer-mobile > ul > a:focus,
      #shopflo-drawer-desktop > ul > a:active,
      #shopflo-drawer-mobile > ul > a:active {
        text-decoration: none;
      }

      #shopflo-drawer-desktop > ul > a:focus .loader-container,
      #shopflo-drawer-mobile > ul > a:focus .loader-container {
        display: flex;
      }

      #shopflo-drawer-desktop > ul > a:focus p,
      #shopflo-drawer-mobile > ul > a:focus p {
        display: none;
      }

      #shopflo-drawer-desktop > ul > a:not(:focus) .loader-container,
      #shopflo-drawer-mobile > ul > a:not(:focus) .loader-container {
        display: none;
      }

      #shopflo-drawer-desktop > ul > a:not(:focus) p,
      #shopflo-drawer-mobile > ul > a:not(:focus) p {
        display: block;
      }

      #shopflo-drawer-desktop > ul > a > p,
      #shopflo-drawer-mobile > ul > a > p {
        font-size: 14px;
        font-weight: 500;
        display: inline-flex;
        gap: 8px;
        align-items: center;
        margin: 10px 0;
        color: #000;
      }

      /* ---- Standalone desktop/mobile wrapper case (separate nodes) ---- */
      .header--icon, .header--icon--mobile {
        cursor: pointer;
        position: relative;
        display: inline-flex;
      }

      #icon-close-shopflo, #icon-close-shopflo-mobile {
        display: none;
        border-radius: 50px;
        border: 1px solid white;
        margin: 0;
        padding: 2px;
        align-items: center;
        justify-content: center;
      }

      svg.loader.flo-loader { position: relative !important; }

      .header--icon--mobile { display: none; }

      @media (max-width: 699px) {
        .header--icon { display: none; }
        .header--icon--mobile { display: inline-flex; }
      }

      /* ---- 'both' case: single shared node, one icon set, visible at all sizes ---- */
      .header--icon-both {
        position: relative;
        display: inline-flex;
      }

      /* ---- Icon + label wrapper ---- */
      .shopflo-icon-label-wrap {
        display: inline-flex;
        cursor: pointer;
      }

      /* position: icon/text order */
      .shopflo-icon-label-wrap.align-right  { flex-direction: row; }
      .shopflo-icon-label-wrap.align-left   { flex-direction: row-reverse; }
      .shopflo-icon-label-wrap.align-bottom { flex-direction: column; }
      .shopflo-icon-label-wrap.align-top    { flex-direction: column-reverse; }

      /* cross-axis alignment (align-items) */
      .shopflo-icon-label-wrap.items-start  { align-items: flex-start; }
      .shopflo-icon-label-wrap.items-center { align-items: center; }
      .shopflo-icon-label-wrap.items-end    { align-items: flex-end; }

      /* main-axis alignment (justify-content) */
      .shopflo-icon-label-wrap.justify-start         { justify-content: flex-start; }
      .shopflo-icon-label-wrap.justify-center        { justify-content: center; }
      .shopflo-icon-label-wrap.justify-end           { justify-content: flex-end; }
      .shopflo-icon-label-wrap.justify-space-between { justify-content: space-between; }

      .shopflo-icon-label-text {
        font-size: 14px;
        font-weight: 500;
        color: #344054;
        white-space: nowrap;
        line-height: 1;
      }
    `;

    var style = document.createElement('style');
    style.innerHTML = css;
    document.head.appendChild(style);
  }

  // Call to inject styles
  appendCss();

  // ------------------------
  // User Icon SVG
  // ------------------------
  const userIcon = `
    <svg width="22" height="22" viewBox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g clip-path="url(#clip0_1997_6385)">
        <rect width="29" height="29" />
        <g stroke="currentColor">
          <path d="M4.833 25.375V22.958C4.833 21.677 5.343 20.447 6.249 19.541C7.155 18.634 8.385 18.125 9.667 18.125H12.688" stroke-width="1.611" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14.5 13.292C17.169 13.292 19.333 11.128 19.333 8.458C19.333 5.789 17.169 3.625 14.5 3.625C11.831 3.625 9.667 5.789 9.667 8.458C9.667 11.128 11.831 13.292 14.5 13.292Z" stroke-width="1.611" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
        <path d="M21.387 12.3L14.171 20.617L20.514 20.743L19.697 26.367L26.912 18.05L20.57 17.924L21.387 12.3Z" fill="#01CCA7" stroke="#01CCA7" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round"/>
      </g>
    </svg>
  `;

  // ------------------------
  // Icons and Dropdowns
  // ------------------------

  // Not logged in icons
  const shopfloNotLoggedIcon = `<div id="flo-login-button-header-logo" style="cursor: pointer; display: flex; align-items: center;">${userIcon}</div>`;
  const shopfloNotLoggedIconMobile = `<div id="flo-login-button-header-logo-mobile" style="cursor: pointer; display: flex;">${userIcon}</div>`;

  // Logged in dropdown for desktop
  const drawerhtmlDesktop = `
    <div id="shopflo-drawer-desktop">
      <ul>
        <a id="account-button-desktop" href="javascript:void(0);" onclick="handleShopifyLogin(event,'/account')">
          <p>Account</p>
          <div class="loader-container">${loader}</div>
        </a>
      </ul>
      <button id="logout-button-desktop"><p>Log out</p></button>
    </div>
  `;

  // Logged in dropdown for mobile
  const drawerhtmlMobile = `
    <div id="shopflo-drawer-mobile">
      <ul>
        <a href="javascript:void(0);" onclick="handleShopifyLogin(event,'/account')">
          <p>Account</p>
          ${loader}
        </a>
      </ul>
      <button id="logout-button-mobile"><p>Logout</p></button>
    </div>
  `;

  // Logged in icon - desktop
  const shopfloLoggedInIcon = `
    <div id="loggedin-icons">
      <div id="icon-close-shopflo" onclick="handleDrawer()" style="height: 25px; width: 25px; cursor: pointer;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div id="icon-shopflo" onclick="handleDrawer()" style="cursor: pointer; display: flex;">${userIcon}</div>
    </div>
  `;

  // Logged in icon - mobile
  const shopfloLoggedInIconMobile = `
    <div id="loggedin-icons-mobile">
      <div id="icon-close-shopflo-mobile" onclick="handleDrawer()" style="cursor: pointer;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.667" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div id="icon-shopflo-mobile" onclick="handleDrawer()" style="cursor: pointer; display: flex;">${userIcon}</div>
    </div>
  `;

  // ------------------------
  // Wraps icon HTML with an optional label, positioned, spaced,
  // and aligned per config. Falls back to sensible defaults if
  // individual fields are omitted. Returns iconHtml unchanged if
  // label is missing or label.enabled is false.
  // ------------------------
  function withLabel(iconHtml, label, floClasses = '') {
    if (!label || !label.enabled) return iconHtml;

    const position = label.position || 'right';   // icon/text order
    const align    = label.align    || 'center';   // cross-axis
    const justify  = label.justify  || 'start';    // main-axis
    const gap      = label.gap      || '6px';      // space between icon & text
    const text     = label.text     || '';

    const classes = [
      'shopflo-icon-label-wrap',
      `align-${position}`,
      `items-${align}`,
      `justify-${justify}`,
      `${floClasses}`
    ].join(' ');

    return `
      <div class="${classes}" style="gap: ${gap};">
        ${iconHtml}
        <span>${text}</span>
      </div>
    `;
  }

  // ------------------------
  // Config-driven header injection
  //
  // key: 'desktop' / 'mobile' -> separate DOM nodes, flat wrapper classes
  // key: 'both'               -> single shared DOM node across breakpoints,
  //                              nested inner containers so CSS toggle still works
  //
  // replaceDom: true  -> original element is replaced (old behavior)
  // replaceDom: false -> original element left untouched, new node inserted after it
  //
  // label: {
  //   enabled: true|false,
  //   text: 'Account',
  //   position: 'right' | 'left' | 'top' | 'bottom',  // icon/text order
  //   align: 'start' | 'center' | 'end',                // cross-axis
  //   justify: 'start' | 'center' | 'end' | 'space-between', // main-axis
  //   gap: '6px'                                          // spacing between icon & text
  // }
  // ------------------------
  const shopfloHeaderConfig = {
    elements: [
      // Active config: single shared account node across all screen sizes.
      //
      // IMPORTANT: shopfloNotLoggedIcon and shopfloLoggedInIcon are two
      // alternate STATES of the same icon (logged-out vs logged-in),
      // toggled via inline display:none/flex by the login/logout JS —
      // only one is ever visible at a time. They must be combined into
      // ONE string and passed to withLabel() ONCE, so there is a single
      // wrapper and a single "Account" label. Calling withLabel()
      // separately on each state creates two wraps (two labels), which
      // is what was causing the "two accounts" rendering.
      {
        key: 'both',
        selector: '.header__icons a[href*="/account"]',
        wrapperClass: 'header--icon-both',
        label: { enabled: false, text: 'Account', position: 'right', align: 'center', justify: 'space-between', gap: '3px' },
        iconsHtml: (label) => withLabel(`${shopfloNotLoggedIcon}${shopfloLoggedInIcon}`, label),
        drawerHtml: () => drawerhtmlDesktop,
        replaceDom: true
      },
      {
        key: 'mobile',
        selector: 'a.nav-bar__link[href*="/account"]',
        wrapperClass: 'header--icon--mobile nav-bar__link',
        label: { enabled: true, text: 'Account', position: 'right', align: 'center', justify: 'space-between', gap: '3px' },
        iconsHtml: (label) => withLabel(`${shopfloNotLoggedIconMobile}${shopfloLoggedInIconMobile}`, label, 'flo-full-width'),
        drawerHtml: () => drawerhtmlMobile,
        replaceDom: true
      }

      // Alternate config: separate desktop + mobile nodes (use this
      // INSTEAD of the 'both' entry above if the theme renders two
      // distinct account links — one in the desktop header, one in
      // the mobile drawer). Same fix applied: each icon pair is
      // combined into one string before a single withLabel() call.
      //
      // ,{
      //   key: 'desktop',
      //   selector: '.header__icons a[href*="/account"]',
      //   wrapperClass: 'header--icon',
      //   label: { enabled: false, text: 'Account', position: 'right', align: 'center', justify: 'start', gap: '6px' },
      //   iconsHtml: (label) => withLabel(`${shopfloNotLoggedIcon}${shopfloLoggedInIcon}`, label),
      //   drawerHtml: () => drawerhtmlDesktop,
      //   replaceDom: true
      // },
      // {
      //   key: 'mobile',
      //   selector: 'a.menu-drawer__account[href*="/account"]',
      //   wrapperClass: 'header--icon--mobile',
      //   label: { enabled: false },
      //   iconsHtml: (label) => withLabel(`${shopfloNotLoggedIconMobile}${shopfloLoggedInIconMobile}`, label),
      //   drawerHtml: () => drawerhtmlMobile,
      //   replaceDom: true
      // }
    ]
  };

  function initShopfloHeader(config) {
    // Step 1: resolve every config entry to its actual DOM node,
    // grouping entries that point at the same node together
    // (covers themes where desktop/mobile selectors collide on one element).
    const nodeGroups = new Map(); // Map<Element, elConfig[]>

    config.elements.forEach((elConfig) => {
      const el = document.querySelector(elConfig.selector);
      if (!el) return;

      if (!nodeGroups.has(el)) nodeGroups.set(el, []);
      nodeGroups.get(el).push(elConfig);
    });

    // Step 2: process each unique node once.
    nodeGroups.forEach((elConfigs, originalEl) => {
      // Skip nodes already handled on a previous run
      if (originalEl.hasAttribute('data-shopflo-processed')) return;

      // Combine markup from every config resolved to this node.
      // For a 'both' entry this is already nested/self-contained;
      // for accidental desktop+mobile collisions on one node, this
      // safely merges both sets of markup into one wrapper.
      const combinedHtml = elConfigs
        .map((c) => `${c.iconsHtml(c.label)}${c.drawerHtml()}`)
        .join('');

      const combinedWrapperClass = [...new Set(
        elConfigs.flatMap((c) => c.wrapperClass.split(' '))
      )].join(' ');

      const primaryWrapperClass = elConfigs[0].wrapperClass.split(' ')[0];

      // Conflict policy: if ANY config for this node says replaceDom: true,
      // we replace (a node can't be both replaced and left-in-place).
      const replaceDom = elConfigs.some((c) => c.replaceDom);

      // Guard against duplicate insertion on repeat calls
      if (replaceDom) {
        if (document.querySelector(`.${primaryWrapperClass}`)) return;
      } else {
        if (originalEl.nextElementSibling?.classList.contains(primaryWrapperClass)) return;
      }

      const wrapperNode = document.createElement('div');
      wrapperNode.className = combinedWrapperClass;
      wrapperNode.innerHTML = combinedHtml;

      if (replaceDom) {
        // ---- Replacement behavior ----
        const parent = originalEl.parentElement;
        if (parent) {
          parent.replaceChild(wrapperNode, originalEl);
        }
      } else {
        // ---- Non-destructive behavior ----
        originalEl.insertAdjacentElement('afterend', wrapperNode);
        originalEl.setAttribute('data-shopflo-processed', 'true');
      }
    });
  }

  initShopfloHeader(shopfloHeaderConfig);
</script>
<!-- Shopflo Script to Add Shopflo Button in the Header [Ends] -->